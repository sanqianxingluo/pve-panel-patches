#!/bin/bash
# pve-hwtools-agent —— PVE 工具集状态代理（V3.0）
#
# 唯一的配置真相：/etc/default/pve-hwtools
# 职责：读/写该配置；施加 CPU 调频；按配置触发界面重渲染。
#
# 由面板「PVE 工具集」页经节点级 API（/nodes/{node}/hwtools）调用；也可手工执行：
#   pve-hwtools-agent status
#   pve-hwtools-agent set show_fan=0 governor=performance freq_max=3800 turbo=0
#   pve-hwtools-agent apply          # 按配置重新施加调频并重渲染（开机自启用）
#   pve-hwtools-agent mirrors        # 列出可选软件源镜像

#
# 单位约定：**配置文件与界面一律用 MHz**（自 V2.1 起）。内核 sysfs 用 kHz，
# 内部换算；若读到大于 10000 的旧值（历史 kHz 写法）自动按 kHz 解释，便于平滑迁移。
set -u

CONF=/etc/default/pve-hwtools
RENDER=/usr/local/bin/pve-hwpatch.sh
MIRROR=/usr/local/bin/pve-mirror-switch.sh
CPUS=/sys/devices/system/cpu

die() { echo "错误：$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "需要 root 权限"; }

# ---------- 缺省值（MHz） ----------
defaults() {
  SHOW_CPU_TEMP=1
  SHOW_FAN=1
  SHOW_DISK=1
  SHOW_CPU_FREQ=1
  BLOCK_SUBSCRIPTION_PROMPT=1
  CPU_GOVERNOR=conservative
  CPU_FREQ_MIN=800
  CPU_FREQ_MAX=3800
  CPU_TURBO=1
  CPU_EPP=balance_performance
  APT_MIRROR=ustc
  # 风扇控制：默认全 off —— 不改变主板原有策略
  #   占空比一律**百分比**（FANn_MANUAL=50 即 50%；曲线 w 也是百分比）
  FAN1_MODE=off; FAN1_SEL=2; FAN1_MANUAL=50; FAN1_CURVE=25:12,30:24,45:47,60:78,80:100
  FAN2_MODE=off; FAN2_SEL=2; FAN2_MANUAL=50; FAN2_CURVE=30:12,40:24,55:47,70:71,80:100
  FAN3_MODE=off; FAN3_SEL=2; FAN3_MANUAL=50; FAN3_CURVE=25:12,30:24,45:47,60:78,80:100
  FAN4_MODE=off; FAN4_SEL=2; FAN4_MANUAL=50; FAN4_CURVE=25:12,30:24,45:47,60:78,80:100
  FAN5_MODE=off; FAN5_SEL=2; FAN5_MANUAL=50; FAN5_CURVE=25:12,30:24,45:47,60:78,80:100
  FAN6_MODE=off; FAN6_SEL=2; FAN6_MANUAL=50; FAN6_CURVE=25:12,30:24,45:47,60:78,80:100
  FAN7_MODE=off; FAN7_SEL=2; FAN7_MANUAL=50; FAN7_CURVE=25:12,30:24,45:47,60:78,80:100
  # 概要页显示：auto = 有转速才显示 / on = 始终显示 / off = 不显示
  # 默认 auto —— 没接风扇的插针自动不出现，不必手工一个个关
  FANCH_SHOW_DEFAULT=auto
  SHOW_FANCH_1=auto; SHOW_FANCH_2=auto; SHOW_FANCH_3=auto; SHOW_FANCH_4=auto
  SHOW_FANCH_5=auto; SHOW_FANCH_6=auto; SHOW_FANCH_7=auto
  # 各通道名字（**通道号与名字是两件事**：芯片只给温度起名，风扇名要用户绑定）
  #   留空 = 未命名，界面显示「通道 N」
  FAN1_NAME=; FAN2_NAME=; FAN3_NAME=; FAN4_NAME=
  FAN5_NAME=; FAN6_NAME=; FAN7_NAME=
}

# 把可能是历史 kHz 写法的值折算成 MHz（>10000 视为 kHz）
to_mhz() {
  case "$1" in
    ''|*[!0-9]*) printf '%s' "$1" ;;
    *) if [ "$1" -gt 10000 ]; then echo $(( $1 / 1000 )); else printf '%s' "$1"; fi ;;
  esac
}

load_conf() {
  defaults
  if [ -f "$CONF" ]; then
    . "$CONF"
    CPU_FREQ_MIN=$(to_mhz "$CPU_FREQ_MIN")
    CPU_FREQ_MAX=$(to_mhz "$CPU_FREQ_MAX")
    # 幂等迁移：老配置里没有 SHOW_FANCH_n，补成 auto。
    #   只补缺失项，绝不覆盖用户已设的值。
    local _n _v
    for _n in $(fan_channels); do
      eval "_v=\${SHOW_FANCH_${_n}:-auto}"
      eval "SHOW_FANCH_${_n}=\$_v"
      eval "_v=\${FAN${_n}_NAME:-}"
      eval "FAN${_n}_NAME=\$_v"
    done
    # 幂等迁移：占空比从「0~255 裸值」改成了「百分比」。
    #   判据：该通道里**任何一项** > 100 就说明它是旧格式（百分比不可能超 100）。
    #   关键：判定必须**按通道整体**做，触发后把该通道的 ALL 值全部换算 ——
    #   不能只换算 >100 的那几个！旧曲线 25:30,30:60,45:120 里的 30/60 是裸值
    #   （真实含义 12%/24%），只挑 >100 的转会留下 30% / 60% 这种错值。
    local _m _curve _t _w _pct _pcts
    for _n in $(fan_channels); do
      _m=0
      eval "_v=\${FAN${_n}_MANUAL:-50}"
      [ "${_v:-0}" -gt 100 ] 2>/dev/null && _m=1
      eval "_curve=\${FAN${_n}_CURVE:-}"
      if [ "$_m" = 0 ] && [ -n "$_curve" ]; then
        IFS=',' read -ra _PP <<< "$_curve"
        for _p in "${_PP[@]}"; do
          _w="${_p##*:}"
          [ "${_w:-0}" -gt 100 ] 2>/dev/null && { _m=1; break; }
        done
      fi
      [ "$_m" = 1 ] || continue
      # 该通道是旧格式：MANUAL 与曲线 w 一律按 0~255 → % 换算
      eval "FAN${_n}_MANUAL=\$(pwm_raw_to_pct \"\${_v:-0}\")"
      if [ -n "$_curve" ]; then
        _pcts=""
        IFS=',' read -ra _P <<< "$_curve"
        for _p in "${_P[@]}"; do
          _t="${_p%%:*}"; _w="${_p##*:}"
          _pcts="$_pcts$_t:$(pwm_raw_to_pct "$_w"),"
        done
        eval "FAN${_n}_CURVE=\${_pcts%,}"
      fi
    done
  fi
  return 0
}

# ---------- 策略（policy）枚举：优先 cpufreq/policy*，退化为 cpu*/cpufreq ----------
policies() {
  local d c
  set -- $CPUS/cpufreq/policy[0-9]*
  if [ -d "$1" ]; then
    for d in $CPUS/cpufreq/policy[0-9]*; do [ -d "$d" ] && echo "$d"; done
    return
  fi
  for c in $CPUS/cpu[0-9]*; do [ -d "$c/cpufreq" ] && echo "$c/cpufreq"; done
}

cpufreq_ok() { [ -d "$CPUS/cpu0/cpufreq" ] || [ -d "$(policies | head -1)" ]; }

# ---------- 硬件事实（一律现读，不缓存；单位 kHz） ----------
hw_min_khz() {
  local m="" v
  for p in $(policies); do v=$(cat "$p/cpuinfo_min_freq" 2>/dev/null); [ -n "$v" ] || continue
    if [ -z "$m" ] || [ "$v" -lt "$m" ]; then m=$v; fi; done
  printf '%s' "${m:-0}"
}
hw_max_khz() {
  local m="" v
  for p in $(policies); do v=$(cat "$p/cpuinfo_max_freq" 2>/dev/null); [ -n "$v" ] || continue
    if [ -z "$m" ] || [ "$v" -gt "$m" ]; then m=$v; fi; done
  printf '%s' "${m:-0}"
}
live_gov()  { local g=""; for p in $(policies); do g=$(cat "$p/scaling_governor" 2>/dev/null); break; done; printf '%s' "${g:-unknown}"; }
live_min()  { local m="" v; for p in $(policies); do v=$(cat "$p/scaling_min_freq" 2>/dev/null); [ -n "$v" ] || continue
              if [ -z "$m" ] || [ "$v" -lt "$m" ]; then m=$v; fi; done; printf '%s' "${m:-0}"; }
live_max()  { local m="" v; for p in $(policies); do v=$(cat "$p/scaling_max_freq" 2>/dev/null); [ -n "$v" ] || continue
              if [ -z "$m" ] || [ "$v" -gt "$m" ]; then m=$v; fi; done; printf '%s' "${m:-0}"; }
live_cur()  { local c=""; for p in $(policies); do c=$(cat "$p/scaling_cur_freq" 2>/dev/null); break; done; printf '%s' "${c:-0}"; }
base_khz()  { local v; v=$(cat "$(policies | head -1)/base_frequency" 2>/dev/null); printf '%s' "${v:-0}"; }
cpudriver() { local v; v=$(cat "$(policies | head -1)/scaling_driver" 2>/dev/null); printf '%s' "${v:-unknown}"; }

# 离散频率表（老式 acpi-cpufreq 才有）
avail_freqs() { local v; v=$(cat "$(policies | head -1)/scaling_available_frequencies" 2>/dev/null); printf '%s' "$v"; }

# 可用调速器：用户列的五种中仅保留内核确实支持者，再补内核上报的其它（去掉 userspace）
avail_govs() { local a=""; a=$(cat "$(policies | head -1)/scaling_available_governors" 2>/dev/null); printf '%s' "$a"; }
gov_list() {
  local all out="" g
  all=$(avail_govs)
  if [ -z "$all" ]; then printf 'performance,powersave,ondemand,conservative,schedutil'; return; fi
  for g in performance powersave ondemand conservative schedutil; do
    case " $all " in *" $g "*) out="$out$g," ;; esac
  done
  for g in $all; do
    case "$g" in userspace|performance|powersave|ondemand|conservative|schedutil) ;; *) out="$out$g," ;; esac
  done
  printf '%s' "${out%,}"
}

# ---------- Turbo / EPP 能力探测 ----------
# Turbo：老 acpi-cpufreq 用 cpufreq/boost（1 开），现代 intel_pstate 用 intel_pstate/no_turbo（1 关，取反）
turbo_file() {
  local f
  for f in $CPUS/cpufreq/boost $CPUS/intel_pstate/no_turbo; do [ -e "$f" ] && { printf '%s' "$f"; return 0; }; done
  return 1
}
turbo_invert() { case "$1" in *no_turbo) return 0 ;; *) return 1 ;; esac; }
turbo_get() {
  local f; f=$(turbo_file) || { printf 'none'; return; }
  local v; v=$(cat "$f" 2>/dev/null)
  if turbo_invert "$f"; then [ "$v" = "1" ] && printf '0' || printf '1'; else printf '%s' "${v:-0}"; fi
}
turbo_avail() { turbo_file >/dev/null 2>&1 && printf '1' || printf '0'; }
epp_avail() { [ -e "$(policies | head -1)/energy_performance_preference" ] && printf '1' || printf '0'; }
epp_names() { cat "$(policies | head -1)/energy_performance_available_preferences" 2>/dev/null; }
epp_cur()   { cat "$(policies | head -1)/energy_performance_preference" 2>/dev/null; }
apstate_status() { cat $CPUS/amd_pstate/status 2>/dev/null; }

# ---------- CPU 身份与世代（映射见共享文件 cpu-model.sh）----------
# 共享文件由 pve-hwpatch.sh 落盘到 /usr/local/lib/pve-hwtools/；
# 万一身处早期升级态而文件缺失，退化为「family/model」直读，绝不因此报错。
CPU_MODEL_SH=/usr/local/lib/pve-hwtools/cpu-model.sh
if [ -r "$CPU_MODEL_SH" ]; then
  . "$CPU_MODEL_SH"
else
  cpu_vendor() { grep -m1 '^vendor_id' /proc/cpuinfo 2>/dev/null | awk '{print $3}'; }
  cpu_fam()    { grep -m1 '^cpu family' /proc/cpuinfo 2>/dev/null | awk '{print $4}'; }
  cpu_mod()    { grep -m1 '^model' /proc/cpuinfo 2>/dev/null | head -1 | sed 's/^model[[:space:]]*:[[:space:]]*//'; }
  cpu_gen()    { printf '%s family %s model %s' "$(cpu_vendor)" "$(cpu_fam)" "$(cpu_mod)"; }
fi

# ---------- 风扇：能力自动探测 ----------
# 硬件：本机 NCT6798D（nct6775 驱动）。能力已实测（2026-09-24）：
#   pwmN_enable 语义：0=全速 1=手动定值 2=温度巡航 3=转速巡航 5=SmartFanIV（硬件曲线）
#                    4=SmartFanIII 在本芯片上被驱动拒绝（6798 只有 IV）
#   五个曲线点可写，温度单位毫摄氏度、占空比百分比（写内核时换成 0-255）。硬件自动执行，**无需守护进程**。
#
# **探测不写死型号**：换主板往往换的是另一颗 Super I/O。若按型号白名单找，换成白名单外
#   的芯片就直接找不到、功能无提示地哑掉。故一律按「能力」找：哪个 hwmon 目录里同时有
#   可写的 pwmN，就是可控风扇芯片。型号家族仅用于**排序**，不是准入门槛。
#   探测结果按 HWID（芯片名 + 该芯片可见通道集合）缓存；换主板或换内核后由
#   「重新扫描通道」按钮或 `fan-rescan` 强制重探，并重置原值基线。
#
# 安全设计（这块是能烧硬件的，务必守）：
#   * 默认 MODE=off —— 什么都不动，沿用主板自己的策略。装上本补丁不会改变风扇行为。
#   * 首次碰某通道前，把它**全部原始值**存进 $FANBASE（每通道一份），MODE=off 即按此还原。
#   * 施加后 3 秒复读转速：原本在转、现在变 0 → **立即还原并报错**（防写错把风扇弄停）。
#   * 手动值下限强制 >= $FAN_PWM_PCT_MIN %，换算后仍绝不写 0。
#   * **换硬件后基线必须重存**：换主板后旧的 pwmN.saved 记的是**别的芯片**的原值，
#     拿它还原等于把前一块板子的设置往新板子上写。
FANBASE=/usr/local/lib/pve-hwtools/fan-baseline
# 界面与配置一律用**百分比**（0~100%），只有最底层写 sysfs 时才换算成 0~255。
#   理由：内核要的是 0~255 的裸占空比，但「手动 128」对人毫无意义，还要人自己
#   心算 50%。存百分比后，界面/配置/日志说的是同一件事，不用来回倒。
FAN_PWM_PCT_MIN=1      # 下限 1%（0% 会停转，一律禁止）
PWM_MAX=255
pwm_pct_to_raw() { printf '%s' "$(( ($1 * PWM_MAX + 50) / 100 ))"; }   # 四舍五入
pwm_raw_to_pct() { printf '%s' "$(( ($1 * 100 + $((PWM_MAX / 2))) / PWM_MAX ))"; }
FAN_REGISTRY=/usr/local/lib/pve-hwtools/fanscan.conf

# 已知 Super I/O 家族（**只用于排序**，不是准入门槛）
fan_chip_rank() {
  case "$1" in
    nct6775|nct6776|nct6779|nct6791|nct6792|nct6793|nct6795|nct6796|nct6797|nct6798)
      printf '1' ;;   # Nuvoton NCT67xx（家用主板最常见的 Super I/O）
    nct6683|nct6686|nct6687)
      printf '2' ;;   # Nuvoton NCT668x
    it87|it8688|it8686|it8792|it8728|it8772|it8620|it8628)
      printf '3' ;;   # ITE IT87xx（另一大派）
    f71882fg|f71868|f71869|f71889|f81866|f81865)
      printf '4' ;;   # Fintek
    w83627ehf|w83627dhg|w83667hg|w83677)
      printf '5' ;;   # Winbond
    *) printf '9' ;;  # 其他：不排除，只是排在后面
  esac
}

# 某个 hwmon 目录里是否存在**可写的裸 pwmN**
# 性能注：pwm[0-9]* 在 nct6798 上能匹配到 138 个文件（pwm1_auto_point1_pwm…）。
# 这里原来每轮 fork 一次 basename，累积几百个子进程，单次 status 要多花约 1 秒。
# 改用 bash 内置参数展开 ${f##*/} 去掉 fork；再用 pwm[0-9] / pwm[0-9][0-9] 两个
# 精确 glob 只取「裸 pwmN」，完全不碰 pwm1_enable 这类带后缀的文件。
fan_dir_usable() {
  local d="$1" f n
  for f in "$d"/pwm[0-9] "$d"/pwm[0-9][0-9]; do
    [ -w "$f" ] || continue
    n=${f##*/}; n=${n#pwm}
    case "$n" in ''|*[!0-9]*) continue ;; esac   # 双保险：跳过带后缀的
    return 0
  done
  return 1
}

# 某个 hwmon 目录的通道指纹：形如 "1,2,3,4,5,7"
# 结果按目录记忆化（同一次运行内 sysfs 不会变），避免 status 里反复重扫。
_FAN_FP_CACHE_DIR=""
_FAN_FP_CACHE_VAL=""
fan_dir_fingerprint() {
    local d="$1" f n out=""
    if [ "$d" = "$_FAN_FP_CACHE_DIR" ]; then printf '%s' "$_FAN_FP_CACHE_VAL"; return 0; fi
    for f in "$d"/pwm[0-9] "$d"/pwm[0-9][0-9]; do
      [ -e "$f" ] || continue
      n=${f##*/}; n=${n#pwm}
      case "$n" in ''|*[!0-9]*) continue ;; esac
      case " $out " in *" $n "*) ;; *) out="$out $n" ;; esac
    done
    # 必须**按数字**排序。shell 的 glob 展开是字典序，通道号上两位数就会露馅：
    # 1..10 会排成 "1 10 2 3 …"，界面于是把「通道 10」排在「通道 1」后面，
    # hwid 指纹也跟着变得难看。sort -n 之后才是 1,2,…,10。
    _FAN_FP_CACHE_DIR="$d"
    if [ -n "$out" ]; then
      _FAN_FP_CACHE_VAL="$(printf '%s' "${out# }" | tr ' ' '\n' | grep -v '^$' | sort -n | tr '\n' ',' | sed 's/,$//')"
    else
      _FAN_FP_CACHE_VAL=""
    fi
    printf '%s' "$_FAN_FP_CACHE_VAL"
}

# 按能力找芯片目录（型号只影响排序，不影响能不能找到）
# 记忆化：status 一行 JSON 里 fan_avail/fan_chip/fan_hwid/fans/fan_sources 都会要它，
# 不缓存就要把 4 个 hwmon 目录扫 10 遍以上。
_FAN_CHIP_DIR_CACHE="__unset__"
fan_chip_dir() {
  if [ "$_FAN_CHIP_DIR_CACHE" != "__unset__" ]; then
    [ -n "$_FAN_CHIP_DIR_CACHE" ] || return 1
    printf '%s' "$_FAN_CHIP_DIR_CACHE"; return 0
  fi
  local best="" bestrank=99 h n rank
  for h in /sys/class/hwmon/hwmon*; do
    [ -r "$h/name" ] || continue
    fan_dir_usable "$h" || continue
    n=$(cat "$h/name" 2>/dev/null)
    rank=$(fan_chip_rank "$n")
    if [ -z "$best" ] || [ "$rank" -lt "$bestrank" ]; then bestrank=$rank; best=$h; fi
  done
  _FAN_CHIP_DIR_CACHE="$best"
  [ -n "$best" ] || return 1
  printf '%s' "$best"; return 0
}

# 旧名兼容（脚本其余各处仍调用 nct_dir）
nct_dir() { fan_chip_dir; }

# 硬件指纹：芯片名 + 该芯片可见通道集合。
#   换主板 → 芯片名变（或芯片数变）→ 指纹变 → 触发重探与基线重置判断。
hwid() {
  local d n
  d=$(fan_chip_dir) || { printf 'none'; return 0; }
  n=$(cat "$d/name" 2>/dev/null)
  printf '%s:ch%s' "$n" "$(fan_dir_fingerprint "$d")"
}

# 本机存在的 pwm 通道号（形如 "1 2 3 4 5 7"）
fan_channels() {
  local d; d=$(fan_chip_dir) || return 0
  printf '%s' "$(fan_dir_fingerprint "$d" | tr ',' ' ')"
}

# 从探测缓存取键（无则给默认）
scan_get() {   # $1=键  $2=默认
  local k="$1" def="${2:-}" v
  [ -r "$FAN_REGISTRY" ] || { printf '%s' "$def"; return 0; }
  v=$(sed -n "s/^${k}=//p" "$FAN_REGISTRY" 2>/dev/null | tail -1)
  [ -n "$v" ] && printf '%s' "$v" || printf '%s' "$def"
}

scan_hwid() { scan_get 'SCAN_HWID' ''; }

# 紧凑格式（目录|名称|通道|可用; …）→ JSON 数组
scan_all_json() {   # $1=紧凑串（空则读缓存）
  local flat="${1:-$(scan_get 'SCAN_ALL' '')}"
  [ -n "$flat" ] || { printf '[]'; return 0; }
  local rec dir nm ch us out=""
  # 注意：此处**不要**用 `local IFS` —— `set -u` 下声明后未赋值就引用会报 unbound
  local savesep="$IFS"
  IFS=';'
  for rec in $flat; do
    IFS='|' read -r dir nm ch us <<EOF
$rec
EOF
    [ -n "$dir" ] || continue
    out="$out{\"dir\":\"$(json_esc "$dir")\",\"name\":\"$(json_esc "$nm")\",\"channels\":\"$(json_esc "$ch")\",\"usable\":$([ "$us" = true ] && echo true || echo false)},"
  done
  IFS="$savesep"
  printf '[%s]' "${out%,}"
}

# 完整探测并写缓存；返回 JSON 摘要
cmd_fan_rescan() {   # $1=keep（1=保留已有通道名与显示设置）
  need_root
  local keep="${1:-0}"
  local h n fp usable rank
  local chosen="" chosenname="" chosenrank=99
  local -a ALLD=() ALLN=() ALLC=() ALLU=()

  for h in /sys/class/hwmon/hwmon*; do
    [ -r "$h/name" ] || continue
    n=$(cat "$h/name" 2>/dev/null)
    fp=$(fan_dir_fingerprint "$h")
    if fan_dir_usable "$h"; then usable=true; else usable=false; fi
    ALLD+=("$h"); ALLN+=("$n"); ALLC+=("$fp"); ALLU+=("$usable")
    [ "$usable" = true ] || continue
    rank=$(fan_chip_rank "$n")
    if [ -z "$chosen" ] || [ "$rank" -lt "$chosenrank" ]; then
      chosenrank=$rank; chosen="$h"; chosenname="$n"
    fi
  done

  # 缓存里存**紧凑无引号格式**（目录|名称|通道|可用，记录间用 ; ）：
  #   带引号的 JSON 存进 shell 变量、再拼回 JSON，转义层数极易搞错
  #   （实测 heredoc 里的 \" 不会被剥掉，拼出来就是非法记号）。
  local i allflat=""
  for i in "${!ALLD[@]}"; do
    allflat="${allflat}${ALLD[$i]}|${ALLN[$i]}|${ALLC[$i]}|${ALLU[$i]};"
  done
  allflat="${allflat%;}"

  local sig="none" chipdir="" ch=""
  if [ -n "$chosen" ]; then
    sig="${chosenname}:ch$(fan_dir_fingerprint "$chosen")"
    ch=$(fan_dir_fingerprint "$chosen" | tr ',' ' ')
    chipdir="$chosen"
  fi

  # 清理旧的通道配置。
  #   keep=1：全留。
  #   keep=0：**全部清掉**——包括新集合里仍存在的通道。换主板后通道号含义全变，
  #           旧「机箱风扇」可能落到新板子的 CPU 插针上，留着名字就是张冠李戴。
  #           名字与模式是用户资产，所以清之前必须由用户明确选择（界面会问）。
  local pruned=""
  if [ "$keep" != "1" ]; then
    local k num
    for k in $(sed -n 's/^\(FAN[0-9]\+\)_.*/\1/p;s/^\(SHOW_FANCH_[0-9]\+\)=.*/\1/p' "$CONF" 2>/dev/null | sort -u); do
      case "$k" in
        FAN*)         num=$(printf '%s' "$k" | sed 's/^FAN\([0-9]\+\)$/\1/') ;;
        SHOW_FANCH_*) num=$(printf '%s' "$k" | sed 's/^SHOW_FANCH_\([0-9]\+\)$/\1/') ;;
        *) continue ;;
      esac
      [ -n "$num" ] || continue
      if [ "${k#SHOW_FANCH_}" != "$k" ]; then
        sed -i "/^SHOW_FANCH_${num}=/d" "$CONF" 2>/dev/null
      else
        sed -i "/^FAN${num}_/d" "$CONF" 2>/dev/null
      fi
      pruned="$pruned $k"
    done
  fi

  local prev; prev=$(scan_hwid)
  mkdir -p "$(dirname "$FAN_REGISTRY")"
  {
    printf 'SCAN_HWID=%s\n' "$sig"
    printf 'SCAN_CHIP=%s\n' "$chosenname"
    printf 'SCAN_DIR=%s\n' "$chipdir"
    printf 'SCAN_CHANNELS=%s\n' "$ch"
    printf 'SCAN_TS=%s\n' "$(date +%s)"
    printf 'SCAN_ALL=%s\n' "$allflat"
  } > "$FAN_REGISTRY"

  printf '{"hwid":"%s","chip":"%s","dir":"%s","channels":"%s","all":%s,"prev_hwid":"%s","keep":%s,"pruned":"%s"}\n' \
    "$sig" "$chosenname" "$chipdir" "$ch" "$(scan_all_json "$allflat")" "$prev" "$keep" "$(printf '%s' "$pruned" | sed 's/^ //')"
}

# 探测缓存是否过期（硬件变了）
fan_scan_stale() {
  local cur old
  cur=$(hwid); old=$(scan_hwid)
  [ -z "$old" ] && return 0
  [ "$cur" != "$old" ] && return 0
  return 1
}

# 硬件有变化（或从未探测）时自动重探，并重置基线
fan_ensure_scan() {
  need_root
  [ -r "$FAN_REGISTRY" ] || { cmd_fan_rescan >/dev/null 2>&1; return 0; }
  if fan_scan_stale; then
    local old; old=$(scan_hwid)
    mkdir -p "$FANBASE"
    # 旧基线按时间戳留存，不删 —— 万一要回退还能查
    mv -f "$FANBASE" "$FANBASE.old-$(date +%s)" 2>/dev/null
    cmd_fan_rescan >/dev/null 2>&1
    printf '风扇硬件已变化（%s → %s），已重新探测并重置原值基线；旧基线留存为 fan-baseline.old-*。\n' \
      "$old" "$(scan_hwid)" >&2
  fi
  return 0
}

fan_rpm()  { local d; d=$(nct_dir) || { printf '0'; return; }; cat "$d/fan${1}_input" 2>/dev/null || printf '0'; }
fan_enable(){ local d; d=$(nct_dir) || return; cat "$d/pwm${1}_enable" 2>/dev/null; }

# 可选温度源：只保留读数为 0 以外、且标签不像 AUXTIN 空脚的
fan_temp_sources() {
  local d; d=$(nct_dir) || return 0
  local t n lbl v out=""
  for t in "$d"/temp[0-9]*_input; do
    [ -e "$t" ] || continue
    n=${t##*/}; n=${n#temp}; n=${n%_input}
    v=$(cat "$t" 2>/dev/null || echo 0)
    # 跳过明显无效的空脚（读数为 0）
    [ "$v" -gt 0 ] 2>/dev/null || continue
    lbl=$(cat "$d/temp${n}_label" 2>/dev/null)
    [ -n "$lbl" ] || lbl="temp$n"
    # 每行一条「编号|标签」。**不能**用空格分隔：标签形如 "PECI Agent 0" 会被拆碎。
    printf '%s|%s\n' "$n" "$lbl"
  done
}

# 保存通道原始状态（只在首次碰它时存，绝不覆盖）
fan_save_baseline() {
  local n="$1" d; d=$(nct_dir) || return 0
  case "$n" in ''|*[!0-9]*) return 0 ;; esac   # 空/非法通道号直接不存，防生成 pwm.saved 空文件
  mkdir -p "$FANBASE"
  [ -f "$FANBASE/pwm${n}.saved" ] && return 0
  {
    for k in enable mode temp_sel floor start stop_time step_up_time step_down_time temp_tolerance; do
      [ -e "$d/pwm${n}_${k}" ] && printf '%s=%s\n' "$k" "$(cat "$d/pwm${n}_${k}" 2>/dev/null)"
    done
    [ -e "$d/pwm${n}" ] && printf 'pwm=%s\n' "$(cat "$d/pwm${n}" 2>/dev/null)"
    for p in 1 2 3 4 5; do
      [ -e "$d/pwm${n}_auto_point${p}_temp" ] && printf 'point%s_temp=%s\n' "$p" "$(cat "$d/pwm${n}_auto_point${p}_temp" 2>/dev/null)"
      [ -e "$d/pwm${n}_auto_point${p}_pwm" ]  && printf 'point%s_pwm=%s\n'  "$p" "$(cat "$d/pwm${n}_auto_point${p}_pwm" 2>/dev/null)"
    done
  } > "$FANBASE/pwm${n}.saved"
}

# 按基线还原某通道
fan_restore_baseline() {
  local n="$1" d f; d=$(nct_dir) || return 0
  [ -f "$FANBASE/pwm${n}.saved" ] || return 0
  while IFS='=' read -r k v; do
    [ -n "$k" ] || continue
    case "$k" in
      enable|mode|temp_sel|floor|start|stop_time|step_up_time|step_down_time|temp_tolerance) f="$d/pwm${n}_${k}" ;;
      pwm) f="$d/pwm${n}" ;;
      point*temp)  f="$d/pwm${n}_auto_${k%_temp}_temp" ;;
      point*pwm)   f="$d/pwm${n}_auto_${k%_pwm}_pwm" ;;
      *) continue ;;
    esac
    [ -e "$f" ] && printf '%s' "$v" > "$f" 2>/dev/null
  done < "$FANBASE/pwm${n}.saved"
  return 0
}

# 校验曲线：形如 25:12,30:24,45:47,60:78,80:100 —— 恰 5 点，温度严格升序，占空比 1~100%
valid_curve() {
  local v="$1" pts t w prev=-1 n=0 out=""
  IFS=',' read -ra pts <<< "$v"
  [ "${#pts[@]}" = 5 ] || die "曲线必须是 5 个点（温度:占空比%，逗号分隔），现为 ${#pts[@]} 个"
  for p in "${pts[@]}"; do
    t="${p%%:*}"; w="${p##*:}"
    case "$t" in ''|*[!0-9]*) die "曲线温度必须是整数摄氏度：$p" ;; esac
    case "$w" in ''|*[!0-9]*) die "曲线占空比必须是整数百分比：$p" ;; esac
    [ "$t" -ge 0 ] && [ "$t" -le 120 ] || die "曲线温度应在 0~120℃：$p"
    [ "$w" -ge "$FAN_PWM_PCT_MIN" ] && [ "$w" -le 100 ] || die "曲线占空比应在 $FAN_PWM_PCT_MIN~100%：$p"
    [ "$t" -gt "$prev" ] || die "曲线温度必须严格递增（前一点 $prev，当前 $t）"
    prev=$t; n=$((n+1))
    out="$out$t:$w,"
  done
  VALID="${out%,}"
}

valid_fan_mode() { case "$1" in off|auto|manual) VALID="$1" ;; *) die "风扇模式只能是 off / auto / manual：$1" ;; esac; }

# 概要页显示设置：auto 只显示在转的 / on 始终显示 / off 不显示
valid_fanch() { case "$1" in auto|on|off) VALID="$1" ;; *) die "显示设置只能是 auto / on / off：$1" ;; esac; }

# 编码为百分号形式。为何要编码：
#   ① 本代理的输出会经 Perl 反引号读入，UTF-8 会被二次编码成乱码（实测中文整段丢失）；
#   ② 编码后是纯 ASCII，既能安全穿过 Perl 与 JSON，也能被前端 decodeURIComponent 还原。
url_encode() {
  local v="$1"
  [ -n "$v" ] || { printf ''; return 0; }
  printf '%s' "$v" | od -An -tx1 | tr -d ' \n' | sed 's/\(..\)/%\1/g'
}

# 解码前端传来的百分号编码名字（前端 encodeURIComponent）。
#   为何要编码：名字可能含空格或中文，而参数之间用空格分隔、后端正则只放行 ASCII；
#   编码后是纯 ASCII，既不破分隔符也不破正则。
url_decode() {
  local v="$1"
  v="${v//+/ }"
  printf '%b' "${v//%/\\x}"
}

# 名字：留空表示清除；非空则限长、去控制字符。
#   名字里不得含 | , = —— 会与概要页的分隔符打架。
valid_fan_name() {
  local v="$1"
  v=$(url_decode "$v")
  v=$(printf '%s' "$v" | tr -d '\000-\037')   # 剥掉全部控制字符（含制表/回车）
  v=$(printf '%s' "$v" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  [ ${#v} -le 32 ] || die "名字过长（最多 32 个字符）"
  # 禁掉 | , = 与单引号：前三个会与概要分隔符/配置语法打架；
  #   单引号必须禁 —— 配置值用单引号包裹，值里再有单引号就得转义，极易写错。
  case "$v" in *"|"*|*,*|*=*) die "名字里不能含 | , = 这几个字符" ;; esac
  case "$v" in *"'"*) die "名字里不能含单引号" ;; esac
  VALID="$v"
}

# 配置文件里的值要用单引号包住：该文件是被 bash source 的，
#   若值含空格（如「CPU 风扇」）而不加引号，bash 会把后面的词当成命令去执行，
#   于是每次读配置都冒 `line N: xxx: command not found`，且名字本身也读不全。
q_conf() { printf "'%s'" "$1"; }

# ── 手动写占空比：**必须先 enable、再写 pwm** ──
#   实测（NCT6798D）：若先写 pwm 再 enable，风扇会先掉速（SmartFan→手动的切换
#   瞬间占空比被清零/锁存到旧值），出现「写 255 反而变慢」的怪象；
#   先 enable 则 pwm 被锁存为当前值，再写目标值即刻生效（255→1605RPM、60→528RPM 实测）。
#   入参是**百分比**（1~100），这里换成内核要的 0~255 再写。
fan_set_manual() {
  local n="$1" pct="$2" d raw; d=$(nct_dir) || return 0
  raw=$(pwm_pct_to_raw "$pct")
  [ "$raw" -lt 1 ] && raw=1        # 双保险：绝不写 0（会停转）
  printf '1' > "$d/pwm${n}_enable" 2>/dev/null
  printf '%s' "$raw" > "$d/pwm${n}" 2>/dev/null
}

# ── 测试识别：让指定通道明显变一次转速，便于听声或盯着看辨位 ──
#   安全：先存基线 → 取与当前差异明显的安全占空比 → 约 10 秒后**无条件还原基线**。
#   绝不写 0；若当前已接近满速，改用一个较低值，制造可闻的「降速」差异。
cmd_fan_test() {
  need_root
  load_conf
  valid_fan_channel "${1:-}"; local n=$VALID
  nct_dir >/dev/null 2>&1 || die "本机无可控风扇芯片"
  local before cur target after i t
  before=$(fan_rpm "$n")
  cur=$(cat "$(nct_dir)/pwm${n}" 2>/dev/null || echo 128)
  # 目标值：与当前差异越大越容易听出来。已接近满速就改走低值。
  #   cur 是内核的裸值 0~255，先转成百分比再比；target 也一律用百分比。
  cur=$(pwm_raw_to_pct "$cur")
  if [ "${cur:-0}" -ge 60 ] 2>/dev/null; then target=25; else target=100; fi
  fan_save_baseline "$n"
  fan_set_manual "$n" "$target"
  peak=0
  for i in 1 2 3 4; do
    sleep 2
    t=$(fan_rpm "$n")
    [ "$t" -gt "$peak" ] && peak=$t
  done
  fan_restore_baseline "$n"
  sleep 4
  after=$(fan_rpm "$n")
  # 如实报告：峰值是否明显偏离起始值（听得出差异才算成功）
  local moved=false
  if [ "$before" -gt 0 ] && [ "$peak" -gt 0 ]; then
    local diff=$(( peak - before )); [ "$diff" -lt 0 ] && diff=$(( -diff ))
    [ "$diff" -ge 150 ] && moved=true
  elif [ "$before" -le 0 ] && [ "$peak" -gt 0 ]; then
    moved=true
  fi
  printf '{"channel":%s,"before":%s,"peak":%s,"after":%s,"target":%s,"moved":%s,"restored":%s}\n' \
    "$n" "$before" "$peak" "$after" "$target" "$moved" "$([ "$before" -eq 0 ] || [ "$after" -gt 0 ] && echo true || echo false)"
}

# ── 自动识别：逐通道试转，判出哪些通道真接着风扇 ──
#   判据：本来就转 => 有；原本 0 转、施加占空比后转起来 => 有；施加后仍 0 => 无。
#   每个通道做完立即还原，绝不留改动。
# ═══════════════════════════════════════════════════════════════
# 自动识别：先探哪些插针真接了风扇，再用 CPU 负载关联找出哪一个是 CPU 风扇。
#   芯片不提供风扇名（fan*_label 全空），所以只能靠「试转 + 负载响应」推断。
#   未接风扇的通道标记 present=false，由调用方决定是否隐藏显示。
#   全程保基线、无条件还原——认风扇不能把用户风扇留在手动全速。
# ═══════════════════════════════════════════════════════════════
# ═══════════════════════════════════════════════════════════════
# 自动识别：先探哪些插针真接了风扇，再用 CPU 负载关联找出哪一个是 CPU 风扇。
#   芯片不提供风扇名（fan*_label 全空），只能靠「试转 + 负载响应」推断。
#   内部一律走 TSV（n rpm peak present bp），最后才拼 JSON——
#   对 JSON 直接做 sed 太脆：模式失配时会把整条记录当数字做算术，当场报错。
#   全程保基线、无条件还原：认风扇不能把用户风扇留在手动全速。
# ═══════════════════════════════════════════════════════════════
fan_rpm_peak() {
  # 采样若干次取峰值：转速表有噪声，单次读数容易被误判
  local n="$1" k="${2:-5}" i v p=0
  for i in $(seq 1 "$k"); do
    v=$(fan_rpm "$n")
    [ "$v" -gt "$p" ] && p=$v
    sleep 1
  done
  printf '%s' "$p"
}

# 一次完整扫描，回传 TSV：n / 静止转速 / 静止峰值 / 是否接了风扇 / 满载峰值
fan_detect_full() {
  need_root
  local d; d=$(nct_dir) || return 0
  local n before peak present
  local -a NS=() RPM=() PEAK=() PRES=()

  # ── 第一轮：存在性。只碰基线转速为 0 的通道——正在转的已确认有风扇，
  #    而且动它风险最大（可能把用户正在用的风扇拽到手动全速）。
  for n in $(fan_channels); do
    before=$(fan_rpm "$n"); present=0; peak=$before
    if [ "$before" -le 0 ]; then
      fan_save_baseline "$n"
      # 先 enable 再 pwm：反序会让风扇先掉速（实测踩过）
      printf '1' > "$d/pwm${n}_enable" 2>/dev/null
      printf '255' > "$d/pwm${n}" 2>/dev/null
      sleep 3
      peak=$(fan_rpm "$n")
      [ "$peak" -gt 0 ] && present=1
      fan_restore_baseline "$n"
    else
      present=1
    fi
    NS+=("$n"); RPM+=("$before"); PEAK+=("$peak"); PRES+=("$present")
  done

  # ── 第二轮：CPU 负载关联。真正贴着 CPU 的那个通道，满载时会明显提速。
  #    轮询采样（每轮把所有通道读一遍、共 5 轮）比逐通道各采 6 秒快得多，
  #    也更容易命中负载峰值窗口。
  local ncore; ncore=$(nproc 2>/dev/null || echo 4)
  [ "$ncore" -gt 8 ] && ncore=8
  timeout 22 bash -c "for i in \$(seq 1 $ncore); do while :; do :; done & done; wait" >/dev/null 2>&1 &
  local loadpid=$!
  sleep 5

  local -A PEAKM=()
  local p v cur
  for p in 1 2 3 4 5 6; do
    for n in "${NS[@]}"; do
      v=$(fan_rpm "$n")
      cur=${PEAKM[$n]:-0}
      [ "$v" -gt "$cur" ] && PEAKM[$n]=$v
    done
    sleep 1
  done
  kill "$loadpid" 2>/dev/null
  wait "$loadpid" 2>/dev/null
  sleep 2

  local i
  for i in "${!NS[@]}"; do
    printf '%s\t%s\t%s\t%s\t%s\n' "${NS[$i]}" "${RPM[$i]}" "${PEAK[$i]}" "${PRES[$i]}" "${PEAKM[${NS[$i]}]:-0}"
  done
}

cmd_fan_detect() {
  need_root
  local out="" n rpm peak pres bp
  while IFS=$(printf '\t') read -r n rpm peak pres bp; do
    [ -z "$n" ] && continue
    local delta=0
    if [ "$pres" = "1" ]; then
      delta=$(( ${bp:-0} - peak )); [ "$delta" -lt 0 ] && delta=0
    fi
    out="$out{\"n\":$n,\"rpm\":$rpm,\"peak\":$peak,\"present\":$([ "$pres" = 1 ] && echo true || echo false),\"delta\":$delta},"
  done <<EOF
$(fan_detect_full)
EOF
  printf '{"channels":[%s]}\n' "${out%,}"
}

# 自动绑定：把识别结果写成通道名（CPU 风扇 / 机箱风扇 N），未接风扇的通道
# 显示策略设为 off，免得面板上挂一排 0 转的假风扇。
# ═══════════════════════════════════════════════════════════════
# 自动绑定风扇（后台任务，结果写 FANPROG 供面板轮询）
#
# 判据分两级，缺一不可：
#  ① 结构证据：pwmN_temp_sel 声明该通道跟随哪个温度源。指向 PECI（CPU 自身
#     温度）的，多半就是 CPU 风扇；指向未接传感器的通道基本是空插针。
#  ② 实测证据（决定性）：把该通道转速压低，看 CPU 温度是否上升。真在给 CPU
#     散热的风扇，减速后 PECI 一定升温；不是的则几乎不动。
#     只靠 ① 会误判（主板默认整排都指向同一路），只靠「听声响」不可复现。
#
# 全程保基线、无条件还原。减速取基线的一半（不是 0），避免把 CPU 逼到降频；
# 每通道测 45 秒，CPU 温度上限远高于阈值，安全。
# ═══════════════════════════════════════════════════════════════
FANPROG=/run/pve-hwtools-fanbind.json

fan_prog() {
  # 进度文件：面板按它显示阶段与百分比
  printf '{"state":"%s","step":"%s","pct":%s,"ts":%s,"result":%s}\n' \
    "$1" "$2" "$3" "$(date +%s)" "${4:-null}" > "$FANPROG" 2>/dev/null
}

# 找出 PECI（CPU 自身温度）对应的 tempN 编号——不同主板编号不同，必须按名字找
peci_temp_index() {
  local d t
  d=$(nct_dir) || return 0
  for t in $(seq 1 16); do
    if [ -r "$d/temp${t}_label" ]; then
      case "$(cat "$d/temp${t}_label" 2>/dev/null)" in
        *PECI*|*peci*) printf '%s' "$t"; return 0 ;;
      esac
    fi
  done
  # 退而求其次：用 CPUTIN
  for t in $(seq 1 16); do
    if [ -r "$d/temp${t}_label" ]; then
      case "$(cat "$d/temp${t}_label" 2>/dev/null)" in
        *CPUTIN*) printf '%s' "$t"; return 0 ;;
      esac
    fi
  done
  return 0
}

# 该通道声明的温度源（temp_sel），读不到就给空
fan_temp_sel() {
  local n="$1" d; d=$(nct_dir) || return 0
  [ -r "$d/pwm${n}_temp_sel" ] && cat "$d/pwm${n}_temp_sel" 2>/dev/null
}

# 实测：把通道 n 减速后，PECI 升温多少度（整数，单位 0.001°C → 这里换算成 mC 差）

# 自动绑定：只做能被证实的判断，不猜测硬件没有的信息。
#   能证实的三件事：
#     ① 哪个插针真接了风扇（静止的插针试转一下，转起来就是有）；
#     ② 该通道的温度源（pwmN_temp_sel 是芯片自己声明的，读得到）；
#     ③ 生成的名字是否合法（写配置前校验）。
#   证不了的事：**物理上哪个是 CPU 风扇**。实测过——把通道 1 从 1108 转压到 349 转，
#   PECI 只从 47000 动到 46000（1°C，在噪声里）。这颗 CPU 待机功耗太低，
#   靠升温差判不出来；强行给结论就是编的。所以名字只按温度源归类，
#   并在结果里如实说明「分不出物理身份，请用测试识别听声」。
#   已有名字一律保留——那是用户自己标的，比推断可信。
cmd_fan_bind() {
  need_root
  load_conf
  local d; d=$(nct_dir) || { printf '{"channels":[]}\n'; return 0; }
  local pi; pi=$(peci_temp_index)
  fan_prog running "正在探测试转各插针…" 20

  local out="" names="" hides="" hidden=""
  local sys_i=0 cpu_i=0 n enc tsel cls label cur
  for n in $(fan_channels); do
    local before peak present
    before=$(fan_rpm "$n"); present=false; peak=$before
    if [ "$before" -gt 0 ]; then
      # 已在转：已确认有风扇，且动它风险最大——绝不打扰
      present=true
    else
      fan_save_baseline "$n"
      # 先 enable 再 pwm：反序会让风扇先掉速（实测踩过）
      printf '1' > "$d/pwm${n}_enable" 2>/dev/null
      printf '255' > "$d/pwm${n}" 2>/dev/null
      sleep 3
      peak=$(fan_rpm "$n")
      [ "$peak" -gt 0 ] && present=true
      fan_restore_baseline "$n"
    fi

    tsel=$(fan_temp_sel "$n")
    if [ -n "$pi" ] && [ "$tsel" = "$pi" ]; then cls="cpu"; else cls="sys"; fi

    if [ "$present" != "true" ]; then
      hidden="$hidden $n"
      hides="$hides show_fanch_${n}=off"
    else
      cur=$(eval "printf '%s' \"\${FAN${n}_NAME:-}\"")
      if [ -z "$cur" ]; then
        if [ "$cls" = "cpu" ]; then
          cpu_i=$((cpu_i + 1))
          label="CPU 风扇"
          [ "$cpu_i" -gt 1 ] && label="CPU 风扇 $cpu_i"
        else
          sys_i=$((sys_i + 1)); label="机箱风扇 $sys_i"
        fi
        enc=$(printf '%s' "$label" | od -An -tx1 | tr -d ' \n' | sed 's/\(..\)/%\1/g')
        names="$names fan${n}_name=$enc"
      fi
    fi
    out="$out{\"n\":$n,\"rpm\":$before,\"peak\":$peak,\"present\":$present,\"temp_sel\":\"$tsel\",\"class\":\"$cls\"},"
  done

  fan_prog running "正在写入通道名与显示设置…" 85
  local all="$names$hides"
  [ -n "$all" ] && cmd_set $all >/dev/null 2>&1

  # 结果必须写进进度文件——面板靠它显示明细；只打 stdout 面板看不到
  local js
  js=$(printf '{"channels":[%s],"cpu_temp":"%s","hidden":"%s"}' \
    "${out%,}" "$pi" "$(printf '%s' "$hidden" | sed 's/^ //')")
  fan_prog done "识别完成" 100 "$js"
  printf '%s\n' "$js"
}

# 通道必须真实存在——否则写进配置也毫无作用，只会让人误以为设好了
valid_fan_channel() {
  local v="$1" n
  case "$v" in ''|*[!0-9]*) die "风扇通道号不合法：$v" ;; esac
  for n in $(fan_channels); do [ "$n" = "$v" ] && { VALID="$v"; return 0; }; done
  die "本机没有风扇通道 $v。可用：$(fan_channels | tr ' ' ' ')"
}
valid_fan_sel() {
  local v="$1" line ok=0
  case "$v" in ''|*[!0-9]*) die "温度源编号必须是整数：$v" ;; esac
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "${line%%|*}" = "$v" ] && ok=1
  done <<EOF
$(fan_temp_sources)
EOF
  [ "$ok" = 1 ] || die "无此温度源：temp$v。可用：$(fan_temp_sources | tr '\n' ' ' | sed 's/|/=/g')"
  VALID="$v"
}
valid_pwm() {
  local v="$1"
  case "$v" in ''|*[!0-9]*) die "占空比必须是整数百分比：$v" ;; esac
  [ "$v" -ge "$FAN_PWM_PCT_MIN" ] && [ "$v" -le 100 ] || die "占空比应在 $FAN_PWM_PCT_MIN~100%（0% 会停转，禁止）：$v"
  VALID="$v"
}

# 施加单个通道
fan_apply_one() {   # $1=通道号
  fan_ensure_scan
  local n="$1" d; d=$(nct_dir) || return 0
  local var="FAN${n}"
  local mode; eval "mode=\${${var}_MODE:-off}"
  local sel;  eval "sel=\${${var}_SEL:-2}"
  local man;  eval "man=\${${var}_MANUAL:-128}"
  local curve; eval "curve=\${${var}_CURVE:-}"

  local before; before=$(fan_rpm "$n")
  fan_save_baseline "$n"

  case "$mode" in
    off)
      fan_restore_baseline "$n"
      return 0 ;;
    manual)
      fan_set_manual "$n" "$man"
      ;;
    auto)
      [ -e "$d/pwm${n}_temp_sel" ] && printf '%s' "$sel" > "$d/pwm${n}_temp_sel" 2>/dev/null
      local i=1 p t w
      IFS=',' read -ra PTS <<< "$curve"
      for p in "${PTS[@]}"; do
        t="${p%%:*}"; w="${p##*:}"
        [ -e "$d/pwm${n}_auto_point${i}_temp" ] && printf '%s' "$(( t * 1000 ))" > "$d/pwm${n}_auto_point${i}_temp" 2>/dev/null
        # 曲线 w 是百分比，内核要 0~255；绝不能写 0（那一点会停转）
        [ -e "$d/pwm${n}_auto_point${i}_pwm" ] && {
          local raw; raw=$(pwm_pct_to_raw "$w"); [ "$raw" -lt 1 ] && raw=1
          printf '%s' "$raw" > "$d/pwm${n}_auto_point${i}_pwm" 2>/dev/null
        }
        i=$((i+1))
      done
      # enable=5 最后写：先把曲线铺好，再交给硬件，避免中途以半截曲线运行
      [ -e "$d/pwm${n}_enable" ] && printf '5' > "$d/pwm${n}_enable" 2>/dev/null
      ;;
  esac

  # 安全阀：原本在转、写完变 0 → 立即还原（可能是写错了通道或占空比过低）
  sleep 3
  local after; after=$(fan_rpm "$n")
  if [ "$before" -gt 0 ] && [ "$after" = 0 ]; then
    fan_restore_baseline "$n"
    die "风扇 $n 施加后停转（原 $before RPM → 0），已还原原状。请检查占空比/温度源。"
  fi
  return 0
}

fan_apply_all() {
  local n
  nct_dir >/dev/null 2>&1 || return 0     # 没有 nct 芯片就静静跳过
  for n in $(fan_channels); do fan_apply_one "$n"; done
  return 0
}

# 状态输出：每个通道一行 JSON 片段
fan_status_json() {
  local n d out=""
  d=$(nct_dir) 2>/dev/null || { printf '[]'; return; }
  for n in $(fan_channels); do
    local mode sel man curve en pwm rpm show nm sel_live
    eval "nm=\${FAN${n}_NAME:-}"
    eval "mode=\${FAN${n}_MODE:-off}"
    eval "sel=\${FAN${n}_SEL:-2}"
    eval "man=\${FAN${n}_MANUAL:-50}"
    eval "curve=\${FAN${n}_CURVE:-25:12,30:24,45:47,60:78,80:100}"
    eval "show=\${SHOW_FANCH_${n}:-${FANCH_SHOW_DEFAULT:-auto}}"
    en=$(cat "$d/pwm${n}_enable" 2>/dev/null || echo -1)
    pwm=$(cat "$d/pwm${n}" 2>/dev/null || echo -1)
    # pwm* 是内核的裸值 0~255；对外一律报**百分比**（-1 表示读不到，原样留着让前端判空）
    [ "$pwm" -ge 0 ] 2>/dev/null && pwm=$(pwm_raw_to_pct "$pwm")
    # 内核实际在跟的温度源：模式为 off 时它才是真相（配置里的 sel 只是「切到自动后才用」），
    # 两者可能不同——不报出来，界面就会显示一个并未生效的值，误导人。
    sel_live=$(cat "$d/pwm${n}_temp_sel" 2>/dev/null || echo 0)
    rpm=$(fan_rpm "$n")
    out="$out{\"n\":$n,\"rpm\":$rpm,\"enable\":$en,\"pwm\":$pwm,\"mode\":\"$mode\",\"sel\":$sel,\"sel_live\":$sel_live,\"manual\":$man,\"curve\":\"$curve\",\"show\":\"$show\",\"name\":\"$(url_encode "$nm")\"},"
  done
  printf '[%s]' "${out%,}"
}

# JSON 字符串转义（标签里可能有引号或反斜杠）
json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

# ── 温度源的人话翻译 ──
# 芯片给的名字（PECI Agent 0 / AUXTIN0 / PCH_CHIP_TEMP）用户看不懂，也不知道该选哪个。
# 按「代表哪里的温度 + 是否推荐」翻译一遍：
#   PECI / CPUTIN = CPU 温度，推荐（PECI 是 CPU 硅片自身温度，最准）
#   SYSTIN        = 主板温度（真正的「主板温度」）
#   PCH_*         = 芯片组
#   AUXTIN*       = 绝大多数主板未接传感器，选它等于风扇不跟任何东西走
fan_temp_role() {   # $1=芯片标签
  case "$1" in
    *PECI*)   printf 'cpu|1' ;;   # CPU 核心（最准）
    *CPUTIN*) printf 'cpu|1' ;;   # CPU 插座
    *SYSTIN*) printf 'sys|0' ;;   # 主板
    *PCH*)    printf 'pch|0' ;;   # 芯片组
    *)        printf 'aux|0' ;;   # 多半是空脚
  esac
}

fan_temp_human() {  # $1=芯片标签 → 人话
  case "$1" in
    *PECI*)   printf 'CPU 核心温度' ;;
    *CPUTIN*) printf 'CPU 插座温度' ;;
    *SYSTIN*) printf '主板温度' ;;
    *PCH_CHIP_CPU_MAX_TEMP*) printf '芯片组（CPU 端）' ;;
    *PCH_CHIP_TEMP*) printf '芯片组' ;;
    *PCH_CPU_TEMP*)  printf '芯片组（CPU 侧）' ;;
    *PCH_MCH_TEMP*)  printf '芯片组（内存侧）' ;;
    AUXTIN*)  printf '未接传感器' ;;
    *)        printf '%s' "$1" ;;
  esac
}

fan_sources_json() {
  local line n lbl v role rec human out=""
  while IFS='|' read -r n lbl; do
    [ -n "$n" ] || continue
    v=$(cat "$(nct_dir)/temp${n}_input" 2>/dev/null || echo 0)
    local rr; rr=$(fan_temp_role "$lbl")
    role="${rr%%|*}"; rec="${rr##*|}"
    human=$(fan_temp_human "$lbl")
    out="$out{\"n\":${n},\"label\":\"$(json_esc "$lbl")\",\"human\":\"$(json_esc "$human")\",\"role\":\"$role\",\"rec\":$rec,\"temp\":$v},"
  done <<EOF
$(fan_temp_sources)
EOF
  printf '[%s]' "${out%,}"
}

# ---------- 校验 ----------
# 说明：这些 valid_* 一律「把结果写进全局 VALID」而非 printf，调用方**直接调用**再读 $VALID。
# 原因：`X=$(valid_...)` 会把函数放进子 shell，里面 die → exit 1 只能杀掉子 shell，
# 父进程照旧往下走，于是非法输入会「打印了错误却仍然写配置」。这个坑必须避开。
valid_gov() {
  local v="$1" g
  for g in $(gov_list | tr ',' ' '); do
    [ "$g" = "$v" ] && { VALID="$v"; return 0; }
  done
  die "不支持的调频模式「$v」。本机可用：$(gov_list | tr ',' ' ')"
}
# 频率：**输入为 MHz**，返回 kHz（供写 sysfs）。同时接受历史 kHz 写法。
valid_freq_mhz() {
  local v="$1" hmin hmax mhz
  case "$v" in ''|*[!0-9]*) die "频率必须是纯数字（单位 MHz）：$v" ;; esac
  if [ "$v" -gt 10000 ]; then mhz=$(( v / 1000 )); else mhz=$v; fi   # 兼容历史 kHz
  hmin=$(( $(hw_min_khz) / 1000 )); hmax=$(( $(hw_max_khz) / 1000 ))
  [ "$mhz" -lt "$hmin" ] && die "频率 $mhz MHz 低于硬件下限 $hmin MHz"
  [ "$mhz" -gt "$hmax" ] && die "频率 $mhz MHz 高于硬件上限 $hmax MHz"
  VALID="$(( mhz * 1000 ))"
}
valid_01() { case "$1" in 0|1) VALID="$1" ;; *) die "开关只能是 0 或 1：$1" ;; esac; }
# 镜像代号：必须是切换脚本自报的可用项之一（既是校验，也挡住 shell 注入）
valid_mirror() {
  local v="$1" m
  [ -x "$MIRROR" ] || die "找不到镜像切换脚本 $MIRROR"
  for m in $("$MIRROR" list 2>/dev/null | awk '/^  [a-z]/ {print $1}'); do
    [ "$m" = "$v" ] && { VALID="$v"; return 0; }
  done
  die "未知镜像「$v」。可用：$("$MIRROR" list 2>/dev/null | awk '/^  [a-z]/ {print $1}' | tr '\n' ' ')"
}
valid_epp() {
  local v="$1" g
  for g in $(epp_names); do [ "$g" = "$v" ] && { VALID="$v"; return 0; }; done
  die "不支持的能效偏好「$v」。本机可用：$(epp_names | tr '\n' ' ')"
}

