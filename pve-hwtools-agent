#!/bin/bash
# pve-hwtools-agent —— PVE 工具集状态代理（V2.2）
#
# 唯一的配置真相：/etc/default/pve-hwtools
# 职责：读/写该配置；施加 CPU 调频；按配置触发界面重渲染。
#
# 由面板「PVE 工具集」页经节点级 API（/nodes/{node}/hwtools）调用；也可手工执行：
#   pve-hwtools-agent status
#   pve-hwtools-agent set show_fan=0 governor=performance freq_max=3800 turbo=0
#   pve-hwtools-agent apply          # 按配置重新施加调频并重渲染（开机自启用）
#   pve-hwtools-agent mirrors        # 列出可选软件源镜像

#
# 单位约定：**配置文件与界面一律用 MHz**（自 V2.1 起）。内核 sysfs 用 kHz，
# 内部换算；若读到大于 10000 的旧值（历史 kHz 写法）自动按 kHz 解释，便于平滑迁移。
set -u

CONF=/etc/default/pve-hwtools
RENDER=/usr/local/bin/pve-hwpatch.sh
MIRROR=/usr/local/bin/pve-mirror-switch.sh
CPUS=/sys/devices/system/cpu

die() { echo "错误：$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "需要 root 权限"; }

# ---------- 缺省值（MHz） ----------
defaults() {
  SHOW_CPU_TEMP=1
  SHOW_FAN=1
  SHOW_DISK=1
  SHOW_CPU_FREQ=1
  BLOCK_SUBSCRIPTION_PROMPT=1
  CPU_GOVERNOR=conservative
  CPU_FREQ_MIN=800
  CPU_FREQ_MAX=3800
  CPU_TURBO=1
  CPU_EPP=balance_performance
  APT_MIRROR=ustc
}

# 把可能是历史 kHz 写法的值折算成 MHz（>10000 视为 kHz）
to_mhz() {
  case "$1" in
    ''|*[!0-9]*) printf '%s' "$1" ;;
    *) if [ "$1" -gt 10000 ]; then echo $(( $1 / 1000 )); else printf '%s' "$1"; fi ;;
  esac
}

load_conf() {
  defaults
  if [ -f "$CONF" ]; then
    . "$CONF"
    CPU_FREQ_MIN=$(to_mhz "$CPU_FREQ_MIN")
    CPU_FREQ_MAX=$(to_mhz "$CPU_FREQ_MAX")
  fi
  return 0
}

# ---------- 策略（policy）枚举：优先 cpufreq/policy*，退化为 cpu*/cpufreq ----------
policies() {
  local d c
  set -- $CPUS/cpufreq/policy[0-9]*
  if [ -d "$1" ]; then
    for d in $CPUS/cpufreq/policy[0-9]*; do [ -d "$d" ] && echo "$d"; done
    return
  fi
  for c in $CPUS/cpu[0-9]*; do [ -d "$c/cpufreq" ] && echo "$c/cpufreq"; done
}

cpufreq_ok() { [ -d "$CPUS/cpu0/cpufreq" ] || [ -d "$(policies | head -1)" ]; }

# ---------- 硬件事实（一律现读，不缓存；单位 kHz） ----------
hw_min_khz() {
  local m="" v
  for p in $(policies); do v=$(cat "$p/cpuinfo_min_freq" 2>/dev/null); [ -n "$v" ] || continue
    if [ -z "$m" ] || [ "$v" -lt "$m" ]; then m=$v; fi; done
  printf '%s' "${m:-0}"
}
hw_max_khz() {
  local m="" v
  for p in $(policies); do v=$(cat "$p/cpuinfo_max_freq" 2>/dev/null); [ -n "$v" ] || continue
    if [ -z "$m" ] || [ "$v" -gt "$m" ]; then m=$v; fi; done
  printf '%s' "${m:-0}"
}
live_gov()  { local g=""; for p in $(policies); do g=$(cat "$p/scaling_governor" 2>/dev/null); break; done; printf '%s' "${g:-unknown}"; }
live_min()  { local m="" v; for p in $(policies); do v=$(cat "$p/scaling_min_freq" 2>/dev/null); [ -n "$v" ] || continue
              if [ -z "$m" ] || [ "$v" -lt "$m" ]; then m=$v; fi; done; printf '%s' "${m:-0}"; }
live_max()  { local m="" v; for p in $(policies); do v=$(cat "$p/scaling_max_freq" 2>/dev/null); [ -n "$v" ] || continue
              if [ -z "$m" ] || [ "$v" -gt "$m" ]; then m=$v; fi; done; printf '%s' "${m:-0}"; }
live_cur()  { local c=""; for p in $(policies); do c=$(cat "$p/scaling_cur_freq" 2>/dev/null); break; done; printf '%s' "${c:-0}"; }
base_khz()  { local v; v=$(cat "$(policies | head -1)/base_frequency" 2>/dev/null); printf '%s' "${v:-0}"; }
cpudriver() { local v; v=$(cat "$(policies | head -1)/scaling_driver" 2>/dev/null); printf '%s' "${v:-unknown}"; }

# 离散频率表（老式 acpi-cpufreq 才有）
avail_freqs() { local v; v=$(cat "$(policies | head -1)/scaling_available_frequencies" 2>/dev/null); printf '%s' "$v"; }

# 可用调速器：用户列的五种中仅保留内核确实支持者，再补内核上报的其它（去掉 userspace）
avail_govs() { local a=""; a=$(cat "$(policies | head -1)/scaling_available_governors" 2>/dev/null); printf '%s' "$a"; }
gov_list() {
  local all out="" g
  all=$(avail_govs)
  if [ -z "$all" ]; then printf 'performance,powersave,ondemand,conservative,schedutil'; return; fi
  for g in performance powersave ondemand conservative schedutil; do
    case " $all " in *" $g "*) out="$out$g," ;; esac
  done
  for g in $all; do
    case "$g" in userspace|performance|powersave|ondemand|conservative|schedutil) ;; *) out="$out$g," ;; esac
  done
  printf '%s' "${out%,}"
}

# ---------- Turbo / EPP 能力探测 ----------
# Turbo：老 acpi-cpufreq 用 cpufreq/boost（1 开），现代 intel_pstate 用 intel_pstate/no_turbo（1 关，取反）
turbo_file() {
  local f
  for f in $CPUS/cpufreq/boost $CPUS/intel_pstate/no_turbo; do [ -e "$f" ] && { printf '%s' "$f"; return 0; }; done
  return 1
}
turbo_invert() { case "$1" in *no_turbo) return 0 ;; *) return 1 ;; esac; }
turbo_get() {
  local f; f=$(turbo_file) || { printf 'none'; return; }
  local v; v=$(cat "$f" 2>/dev/null)
  if turbo_invert "$f"; then [ "$v" = "1" ] && printf '0' || printf '1'; else printf '%s' "${v:-0}"; fi
}
turbo_avail() { turbo_file >/dev/null 2>&1 && printf '1' || printf '0'; }
epp_avail() { [ -e "$(policies | head -1)/energy_performance_preference" ] && printf '1' || printf '0'; }
epp_names() { cat "$(policies | head -1)/energy_performance_available_preferences" 2>/dev/null; }
epp_cur()   { cat "$(policies | head -1)/energy_performance_preference" 2>/dev/null; }
apstate_status() { cat $CPUS/amd_pstate/status 2>/dev/null; }

# ---------- CPU 身份与世代（映射见共享文件 cpu-model.sh）----------
# 共享文件由 pve-hwpatch.sh 落盘到 /usr/local/lib/pve-hwtools/；
# 万一身处早期升级态而文件缺失，退化为「family/model」直读，绝不因此报错。
CPU_MODEL_SH=/usr/local/lib/pve-hwtools/cpu-model.sh
if [ -r "$CPU_MODEL_SH" ]; then
  . "$CPU_MODEL_SH"
else
  cpu_vendor() { grep -m1 '^vendor_id' /proc/cpuinfo 2>/dev/null | awk '{print $3}'; }
  cpu_fam()    { grep -m1 '^cpu family' /proc/cpuinfo 2>/dev/null | awk '{print $4}'; }
  cpu_mod()    { grep -m1 '^model' /proc/cpuinfo 2>/dev/null | head -1 | sed 's/^model[[:space:]]*:[[:space:]]*//'; }
  cpu_gen()    { printf '%s family %s model %s' "$(cpu_vendor)" "$(cpu_fam)" "$(cpu_mod)"; }
fi

# ---------- 校验 ----------
valid_gov() {
  local v="$1" g
  for g in $(gov_list | tr ',' ' '); do
    [ "$g" = "$v" ] && { printf '%s' "$v"; return 0; }
  done
  die "不支持的调频模式「$v」。本机可用：$(gov_list | tr ',' ' ')"
}
# 频率：**输入为 MHz**，返回 kHz（供写 sysfs）。同时接受历史 kHz 写法。
valid_freq_mhz() {
  local v="$1" hmin hmax mhz
  case "$v" in ''|*[!0-9]*) die "频率必须是纯数字（单位 MHz）：$v" ;; esac
  if [ "$v" -gt 10000 ]; then mhz=$(( v / 1000 )); else mhz=$v; fi   # 兼容历史 kHz
  hmin=$(( $(hw_min_khz) / 1000 )); hmax=$(( $(hw_max_khz) / 1000 ))
  [ "$mhz" -lt "$hmin" ] && die "频率 $mhz MHz 低于硬件下限 $hmin MHz"
  [ "$mhz" -gt "$hmax" ] && die "频率 $mhz MHz 高于硬件上限 $hmax MHz"
  printf '%s' "$(( mhz * 1000 ))"
}
valid_01() { case "$1" in 0|1) printf '%s' "$1" ;; *) die "开关只能是 0 或 1：$1" ;; esac; }
# 镜像代号：必须是切换脚本自报的可用项之一（既是校验，也挡住 shell 注入）
valid_mirror() {
  local v="$1" m
  [ -x "$MIRROR" ] || die "找不到镜像切换脚本 $MIRROR"
  for m in $("$MIRROR" list 2>/dev/null | awk '/^  [a-z]/ {print $1}'); do
    [ "$m" = "$v" ] && { printf '%s' "$v"; return 0; }
  done
  die "未知镜像「$v」。可用：$("$MIRROR" list 2>/dev/null | awk '/^  [a-z]/ {print $1}' | tr '\n' ' ')"
}
valid_epp() {
  local v="$1" g
  for g in $(epp_names); do [ "$g" = "$v" ] && { printf '%s' "$v"; return 0; }; done
  die "不支持的能效偏好「$v」。本机可用：$(epp_names | tr '\n' ' ')"
}

# ---------- 写配置（MHz） ----------
write_conf() {
  cat > "$CONF" <<EOF
# PVE 工具集配置 —— 由面板「PVE 工具集」页生成，也可手工编辑
# 改后执行： /usr/local/bin/pve-hwtools-agent apply
#
# 概要显示开关（1 开 / 0 关）
SHOW_CPU_TEMP=$SHOW_CPU_TEMP
SHOW_FAN=$SHOW_FAN
SHOW_DISK=$SHOW_DISK
SHOW_CPU_FREQ=$SHOW_CPU_FREQ
#
# 屏蔽「无有效订阅」弹窗
BLOCK_SUBSCRIPTION_PROMPT=$BLOCK_SUBSCRIPTION_PROMPT
#
# CPU 调频（频率单位 **MHz**；范围须落在硬件能力内）
CPU_GOVERNOR=$CPU_GOVERNOR
CPU_FREQ_MIN=$CPU_FREQ_MIN
CPU_FREQ_MAX=$CPU_FREQ_MAX
# Turbo（1 启用 / 0 关闭；本机不支持时该项被忽略）
CPU_TURBO=$CPU_TURBO
# 能效偏好 EPP（仅部分新平台支持：performance / balance_performance / balance_power / power）
CPU_EPP=$CPU_EPP
#
# 软件源镜像（切换脚本见 /usr/local/bin/pve-mirror-switch.sh）
#   可选：ustc 中科大 / tuna 清华 / aliyun 阿里云 / tencent 腾讯云 / huawei 华为云 / official 官方源
APT_MIRROR=$APT_MIRROR
EOF
  chmod 644 "$CONF"
}

# ---------- 施加 CPU 调频 ----------
# 逐策略写 sysfs（内核自身接口，最通用）；写完回读校验，不符则用 cpupower 兜底一次。
apply_one() {   # $1=policy 目录  $2=governor（空则不动）  $3=min kHz  $4=max kHz
  local p=$1 g=$2 lo=$3 hi=$4
  [ -e "$p/scaling_min_freq" ] && printf '%s' "$lo" > "$p/scaling_min_freq" 2>/dev/null
  [ -e "$p/scaling_max_freq" ] && printf '%s' "$hi" > "$p/scaling_max_freq" 2>/dev/null
  [ -n "$g" ] && [ -e "$p/scaling_governor" ] && printf '%s' "$g" > "$p/scaling_governor" 2>/dev/null
  return 0
}
apply_freq() {
  local g="$CPU_GOVERNOR" lo=$(( CPU_FREQ_MIN * 1000 )) hi=$(( CPU_FREQ_MAX * 1000 ))
  local p bad=0
  cpufreq_ok || die "本机无 cpufreq 接口，无法设置调频（旧内核或禁用了调频驱动）"
  for p in $(policies); do apply_one "$p" "$g" "$lo" "$hi" || bad=1; done

  local lg lm lx
  lg=$(live_gov); lm=$(live_min); lx=$(live_max)
  if [ "$lg" != "$g" ] || [ "$lm" != "$lo" ] || [ "$lx" != "$hi" ]; then
    # 兜底：部分驱动只认 cpupower 的组合设置
    if command -v cpupower >/dev/null 2>&1; then
      cpupower frequency-set -g "$g" -d "${CPU_FREQ_MIN}MHz" -u "${CPU_FREQ_MAX}MHz" >/dev/null 2>&1 || true
      lg=$(live_gov); lm=$(live_min); lx=$(live_max)
    fi
    bad=0
    [ "$lg" != "$g" ] && bad=1
    [ "$lm" != "$lo" ] && bad=1
    [ "$lx" != "$hi" ] && bad=1
  fi
  [ "$bad" = 0 ] || die "调频未按预期生效：期望 $g ${CPU_FREQ_MIN}MHz~${CPU_FREQ_MAX}MHz，实际 $lg $((lm/1000))MHz~$((lx/1000))MHz"
  return 0
}
apply_turbo() {
  local f; f=$(turbo_file) || return 0
  local want="$CPU_TURBO" v
  if turbo_invert "$f"; then [ "$want" = "1" ] && v=0 || v=1; else v="$want"; fi
  printf '%s' "$v" > "$f" 2>/dev/null || return 0
  return 0
}
apply_epp() {
  local p base="$CPU_EPP"
  epp_avail >/dev/null || return 0
  [ -n "$base" ] || return 0
  for p in $(policies); do
    [ -e "$p/energy_performance_preference" ] || continue
    case " $(epp_names) " in *" $base "*) printf '%s' "$base" > "$p/energy_performance_preference" 2>/dev/null ;; esac
  done
  return 0
}

# ---------- 状态（JSON，频率一律 MHz） ----------
emit_status() {
  load_conf
  local jg="" g
  for g in $(gov_list | tr ',' ' '); do jg="$jg\"$g\","; done
  jg="${jg%,}"
  local je="" e
  for e in $(epp_names); do case "$e" in default) ;; *) je="$je\"$e\"," ;; esac; done
  je="${je%,}"
  local base; base=$(base_khz)
  cat <<EOF
{"show_cpu_temp":$SHOW_CPU_TEMP,"show_fan":$SHOW_FAN,"show_disk":$SHOW_DISK,"show_cpu_freq":$SHOW_CPU_FREQ,"block_subscription":$BLOCK_SUBSCRIPTION_PROMPT,"governor":"$CPU_GOVERNOR","governors":[$jg],"freq_min":$CPU_FREQ_MIN,"freq_max":$CPU_FREQ_MAX,"governor_live":"$(live_gov)","freq_min_live":$(( $(live_min) / 1000 )),"freq_max_live":$(( $(live_max) / 1000 )),"freq_cur":$(( $(live_cur) / 1000 )),"freq_hw_min":$(( $(hw_min_khz) / 1000 )),"freq_hw_max":$(( $(hw_max_khz) / 1000 )),"base_freq":$(( base / 1000 )),"turbo":$(turbo_get),"turbo_avail":$(turbo_avail),"epp":"$(epp_cur)","epp_avail":$(epp_avail),"epp_list":[$je],"driver":"$(cpudriver)","amd_pstate":"$(apstate_status)","policies":$(policies | wc -l),"cpufreq_ok":$(cpufreq_ok && echo 1 || echo 0),"cpu_brand":"$(cpu_brand)","cpu_gen":"$(cpu_gen)","cpu_vendor":"$(cpu_vendor)","apt_mirror":"$APT_MIRROR","apt_mirror_live":"$(if [ -x "$MIRROR" ]; then "$MIRROR" status 2>/dev/null | sed -n 's/.*"apt_mirror_detected":"\([^"]*\)".*/\1/p'; fi)","mirror_list":"$(if [ -x "$MIRROR" ]; then "$MIRROR" list 2>/dev/null | awk '/^  [a-z]/ {print $1}' | tr '\n' ','; fi)","apt_mirror_avail":$([ -x "$MIRROR" ] && echo true || echo false),"config_file":"$CONF"}
EOF
}

# ---------- 命令 ----------
cmd_status() { emit_status; }

cmd_set() {
  need_root
  load_conf
  [ $# -gt 0 ] || die "set 需要至少一个 k=v 参数"

  local gov="$CPU_GOVERNOR" fmin="$CPU_FREQ_MIN" fmax="$CPU_FREQ_MAX"
  local turbo="$CPU_TURBO" epp="$CPU_EPP"
  local freq_changed=0 other_changed=0 mirror_changed=0 kv k v

  for kv in "$@"; do
    k="${kv%%=*}"; v="${kv#*=}"
    case "$k" in
      show_cpu_temp) SHOW_CPU_TEMP=$(valid_01 "$v") ;;
      show_fan) SHOW_FAN=$(valid_01 "$v") ;;
      show_disk) SHOW_DISK=$(valid_01 "$v") ;;
      show_cpu_freq) SHOW_CPU_FREQ=$(valid_01 "$v") ;;
      block_subscription) BLOCK_SUBSCRIPTION_PROMPT=$(valid_01 "$v") ;;
      governor) gov=$(valid_gov "$v"); freq_changed=1 ;;
      freq_min) fmin=$(( $(valid_freq_mhz "$v") / 1000 )); freq_changed=1 ;;
      freq_max) fmax=$(( $(valid_freq_mhz "$v") / 1000 )); freq_changed=1 ;;
      turbo) turbo=$(valid_01 "$v"); other_changed=1 ;;
      epp) epp=$(valid_epp "$v"); other_changed=1 ;;
      apt_mirror) APT_MIRROR=$(valid_mirror "$v") ; mirror_changed=1 ;;
      *) die "未知配置项：$k" ;;
    esac
  done
  [ "$fmin" -le "$fmax" ] || die "频率下限（$fmin MHz）不能高于上限（$fmax MHz）"
  if [ "$freq_changed" = 1 ]; then
    local flim=$(( $(hw_min_khz) / 1000 )) hlim=$(( $(hw_max_khz) / 1000 ))
    [ "$fmin" -ge "$flim" ] || die "频率下限 $fmin MHz 低于硬件下限 $flim MHz"
    [ "$fmax" -le "$hlim" ] || die "频率上限 $fmax MHz 高于硬件上限 $hlim MHz"
  fi

  CPU_GOVERNOR="$gov"; CPU_FREQ_MIN="$fmin"; CPU_FREQ_MAX="$fmax"
  CPU_TURBO="$turbo"; CPU_EPP="$epp"

  # 先生效；失败则不落盘（保证配置与系统状态一致）
  if [ "$freq_changed" = 1 ]; then apply_freq; fi
  if [ "$other_changed" = 1 ]; then apply_turbo; apply_epp; fi

  write_conf
  if [ "$mirror_changed" = 1 ] && [ -x "$MIRROR" ]; then
    # 切换只改写源文件，不做连通性验证；输出透出去，便于界面/终端看到改了什么
    "$MIRROR" set "$APT_MIRROR" 2>&1 | sed 's/^/      /' >&2 || true
  fi
  if [ -x "$RENDER" ]; then "$RENDER" >/dev/null 2>&1; fi
  emit_status
}

cmd_mirrors() {
  if [ -x "$MIRROR" ]; then "$MIRROR" list; else die "找不到 $MIRROR"; fi
}

cmd_apply() {
  need_root
  load_conf
  if cpufreq_ok; then apply_freq 2>/dev/null || true; fi
  apply_turbo
  apply_epp
  if [ -x "$RENDER" ]; then "$RENDER" >/dev/null 2>&1; fi
  emit_status
}

case "${1:-status}" in
  status) cmd_status ;;
  set) shift; cmd_set "$@" ;;
  apply) cmd_apply ;;
  mirrors) cmd_mirrors ;;
  *) die "用法：pve-hwtools-agent {status|set k=v...|apply|mirrors}" ;;
esac
