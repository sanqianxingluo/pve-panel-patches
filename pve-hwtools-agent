#!/bin/bash
# pve-hwtools-agent —— PVE 工具集状态代理（V2.4）
#
# 唯一的配置真相：/etc/default/pve-hwtools
# 职责：读/写该配置；施加 CPU 调频；按配置触发界面重渲染。
#
# 由面板「PVE 工具集」页经节点级 API（/nodes/{node}/hwtools）调用；也可手工执行：
#   pve-hwtools-agent status
#   pve-hwtools-agent set show_fan=0 governor=performance freq_max=3800 turbo=0
#   pve-hwtools-agent apply          # 按配置重新施加调频并重渲染（开机自启用）
#   pve-hwtools-agent mirrors        # 列出可选软件源镜像

#
# 单位约定：**配置文件与界面一律用 MHz**（自 V2.1 起）。内核 sysfs 用 kHz，
# 内部换算；若读到大于 10000 的旧值（历史 kHz 写法）自动按 kHz 解释，便于平滑迁移。
set -u

CONF=/etc/default/pve-hwtools
RENDER=/usr/local/bin/pve-hwpatch.sh
MIRROR=/usr/local/bin/pve-mirror-switch.sh
CPUS=/sys/devices/system/cpu

die() { echo "错误：$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "需要 root 权限"; }

# ---------- 缺省值（MHz） ----------
defaults() {
  SHOW_CPU_TEMP=1
  SHOW_FAN=1
  SHOW_DISK=1
  SHOW_CPU_FREQ=1
  BLOCK_SUBSCRIPTION_PROMPT=1
  CPU_GOVERNOR=conservative
  CPU_FREQ_MIN=800
  CPU_FREQ_MAX=3800
  CPU_TURBO=1
  CPU_EPP=balance_performance
  APT_MIRROR=ustc
  # 风扇控制：默认全 off —— 不改变主板原有策略
  FAN1_MODE=off; FAN1_SEL=2; FAN1_MANUAL=128; FAN1_CURVE=25:30,30:60,45:120,60:200,80:255
  FAN2_MODE=off; FAN2_SEL=2; FAN2_MANUAL=128; FAN2_CURVE=30:30,40:60,55:120,70:180,80:255
  FAN3_MODE=off; FAN3_SEL=2; FAN3_MANUAL=128; FAN3_CURVE=25:30,30:60,45:120,60:200,80:255
  FAN4_MODE=off; FAN4_SEL=2; FAN4_MANUAL=128; FAN4_CURVE=25:30,30:60,45:120,60:200,80:255
  FAN5_MODE=off; FAN5_SEL=2; FAN5_MANUAL=128; FAN5_CURVE=25:30,30:60,45:120,60:200,80:255
  FAN6_MODE=off; FAN6_SEL=2; FAN6_MANUAL=128; FAN6_CURVE=25:30,30:60,45:120,60:200,80:255
  FAN7_MODE=off; FAN7_SEL=2; FAN7_MANUAL=128; FAN7_CURVE=25:30,30:60,45:120,60:200,80:255
}

# 把可能是历史 kHz 写法的值折算成 MHz（>10000 视为 kHz）
to_mhz() {
  case "$1" in
    ''|*[!0-9]*) printf '%s' "$1" ;;
    *) if [ "$1" -gt 10000 ]; then echo $(( $1 / 1000 )); else printf '%s' "$1"; fi ;;
  esac
}

load_conf() {
  defaults
  if [ -f "$CONF" ]; then
    . "$CONF"
    CPU_FREQ_MIN=$(to_mhz "$CPU_FREQ_MIN")
    CPU_FREQ_MAX=$(to_mhz "$CPU_FREQ_MAX")
  fi
  return 0
}

# ---------- 策略（policy）枚举：优先 cpufreq/policy*，退化为 cpu*/cpufreq ----------
policies() {
  local d c
  set -- $CPUS/cpufreq/policy[0-9]*
  if [ -d "$1" ]; then
    for d in $CPUS/cpufreq/policy[0-9]*; do [ -d "$d" ] && echo "$d"; done
    return
  fi
  for c in $CPUS/cpu[0-9]*; do [ -d "$c/cpufreq" ] && echo "$c/cpufreq"; done
}

cpufreq_ok() { [ -d "$CPUS/cpu0/cpufreq" ] || [ -d "$(policies | head -1)" ]; }

# ---------- 硬件事实（一律现读，不缓存；单位 kHz） ----------
hw_min_khz() {
  local m="" v
  for p in $(policies); do v=$(cat "$p/cpuinfo_min_freq" 2>/dev/null); [ -n "$v" ] || continue
    if [ -z "$m" ] || [ "$v" -lt "$m" ]; then m=$v; fi; done
  printf '%s' "${m:-0}"
}
hw_max_khz() {
  local m="" v
  for p in $(policies); do v=$(cat "$p/cpuinfo_max_freq" 2>/dev/null); [ -n "$v" ] || continue
    if [ -z "$m" ] || [ "$v" -gt "$m" ]; then m=$v; fi; done
  printf '%s' "${m:-0}"
}
live_gov()  { local g=""; for p in $(policies); do g=$(cat "$p/scaling_governor" 2>/dev/null); break; done; printf '%s' "${g:-unknown}"; }
live_min()  { local m="" v; for p in $(policies); do v=$(cat "$p/scaling_min_freq" 2>/dev/null); [ -n "$v" ] || continue
              if [ -z "$m" ] || [ "$v" -lt "$m" ]; then m=$v; fi; done; printf '%s' "${m:-0}"; }
live_max()  { local m="" v; for p in $(policies); do v=$(cat "$p/scaling_max_freq" 2>/dev/null); [ -n "$v" ] || continue
              if [ -z "$m" ] || [ "$v" -gt "$m" ]; then m=$v; fi; done; printf '%s' "${m:-0}"; }
live_cur()  { local c=""; for p in $(policies); do c=$(cat "$p/scaling_cur_freq" 2>/dev/null); break; done; printf '%s' "${c:-0}"; }
base_khz()  { local v; v=$(cat "$(policies | head -1)/base_frequency" 2>/dev/null); printf '%s' "${v:-0}"; }
cpudriver() { local v; v=$(cat "$(policies | head -1)/scaling_driver" 2>/dev/null); printf '%s' "${v:-unknown}"; }

# 离散频率表（老式 acpi-cpufreq 才有）
avail_freqs() { local v; v=$(cat "$(policies | head -1)/scaling_available_frequencies" 2>/dev/null); printf '%s' "$v"; }

# 可用调速器：用户列的五种中仅保留内核确实支持者，再补内核上报的其它（去掉 userspace）
avail_govs() { local a=""; a=$(cat "$(policies | head -1)/scaling_available_governors" 2>/dev/null); printf '%s' "$a"; }
gov_list() {
  local all out="" g
  all=$(avail_govs)
  if [ -z "$all" ]; then printf 'performance,powersave,ondemand,conservative,schedutil'; return; fi
  for g in performance powersave ondemand conservative schedutil; do
    case " $all " in *" $g "*) out="$out$g," ;; esac
  done
  for g in $all; do
    case "$g" in userspace|performance|powersave|ondemand|conservative|schedutil) ;; *) out="$out$g," ;; esac
  done
  printf '%s' "${out%,}"
}

# ---------- Turbo / EPP 能力探测 ----------
# Turbo：老 acpi-cpufreq 用 cpufreq/boost（1 开），现代 intel_pstate 用 intel_pstate/no_turbo（1 关，取反）
turbo_file() {
  local f
  for f in $CPUS/cpufreq/boost $CPUS/intel_pstate/no_turbo; do [ -e "$f" ] && { printf '%s' "$f"; return 0; }; done
  return 1
}
turbo_invert() { case "$1" in *no_turbo) return 0 ;; *) return 1 ;; esac; }
turbo_get() {
  local f; f=$(turbo_file) || { printf 'none'; return; }
  local v; v=$(cat "$f" 2>/dev/null)
  if turbo_invert "$f"; then [ "$v" = "1" ] && printf '0' || printf '1'; else printf '%s' "${v:-0}"; fi
}
turbo_avail() { turbo_file >/dev/null 2>&1 && printf '1' || printf '0'; }
epp_avail() { [ -e "$(policies | head -1)/energy_performance_preference" ] && printf '1' || printf '0'; }
epp_names() { cat "$(policies | head -1)/energy_performance_available_preferences" 2>/dev/null; }
epp_cur()   { cat "$(policies | head -1)/energy_performance_preference" 2>/dev/null; }
apstate_status() { cat $CPUS/amd_pstate/status 2>/dev/null; }

# ---------- CPU 身份与世代（映射见共享文件 cpu-model.sh）----------
# 共享文件由 pve-hwpatch.sh 落盘到 /usr/local/lib/pve-hwtools/；
# 万一身处早期升级态而文件缺失，退化为「family/model」直读，绝不因此报错。
CPU_MODEL_SH=/usr/local/lib/pve-hwtools/cpu-model.sh
if [ -r "$CPU_MODEL_SH" ]; then
  . "$CPU_MODEL_SH"
else
  cpu_vendor() { grep -m1 '^vendor_id' /proc/cpuinfo 2>/dev/null | awk '{print $3}'; }
  cpu_fam()    { grep -m1 '^cpu family' /proc/cpuinfo 2>/dev/null | awk '{print $4}'; }
  cpu_mod()    { grep -m1 '^model' /proc/cpuinfo 2>/dev/null | head -1 | sed 's/^model[[:space:]]*:[[:space:]]*//'; }
  cpu_gen()    { printf '%s family %s model %s' "$(cpu_vendor)" "$(cpu_fam)" "$(cpu_mod)"; }
fi

# ---------- 风扇控制 ----------
# 硬件：NCT6798D（nct6775 驱动）。能力已实测（2026-09-24）：
#   pwmN_enable 语义：0=全速 1=手动定值 2=温度巡航 3=转速巡航 5=SmartFanIV（硬件曲线）
#                    4=SmartFanIII 在本芯片上被驱动拒绝（6798 只有 IV）
#   五个曲线点 writeable，温度单位毫摄氏度、占空比 0-255。硬件自动执行，**无需守护进程**。
#
# 安全设计（这块是能烧硬件的，务必守）：
#   * 默认 MODE=off —— 什么都不动，沿用主板自己的策略。装上本补丁不会改变风扇行为。
#   * 首次碰某通道前，把它**全部原始值**存进 $FANBASE（每通道一份），MODE=off 即按此还原。
#   * 施加后 3 秒复读转速：原本在转、现在变 0 → **立即还原并报错**（防写错把风扇弄停）。
#   * 手动值下限强制 >= $FAN_PWM_MIN，绝不写 0。
FANBASE=/usr/local/lib/pve-hwtools/fan-baseline
FAN_PWM_MIN=1          # 手动占空比下限（0=停转，一律禁止）

# nct 芯片所在的 hwmon 目录——**必须按名字现找**，hwmon 序号会随内核/设备变动而变
nct_dir() {
  local h n
  for h in /sys/class/hwmon/hwmon*; do
    [ -r "$h/name" ] || continue
    n=$(cat "$h/name" 2>/dev/null)
    case "$n" in nct6775|nct6776|nct6779|nct6791|nct6792|nct6793|nct6795|nct6796|nct6797|nct6798|nct6683|nct6686|nct6687)
      printf '%s' "$h"; return 0 ;;
    esac
  done
  return 1
}

# 本机存在的 pwm 通道号（形如 "1 2 3 4 5 7"）
fan_channels() {
  local d; d=$(nct_dir) || return 0
  local f n out=""
  for f in "$d"/pwm[0-9]*; do
    [ -e "$f" ] || continue
    n=$(basename "$f"); n=${n#pwm}
    case "$n" in *[!0-9]*) continue ;; esac
    case " $out " in *" $n "*) ;; *) out="$out $n" ;; esac
  done
  printf '%s' "${out# }"
}

fan_rpm()  { local d; d=$(nct_dir) || { printf '0'; return; }; cat "$d/fan${1}_input" 2>/dev/null || printf '0'; }
fan_enable(){ local d; d=$(nct_dir) || return; cat "$d/pwm${1}_enable" 2>/dev/null; }
fan_temp_sel(){ local d; d=$(nct_dir) || return; cat "$d/pwm${1}_temp_sel" 2>/dev/null; }

# 可选温度源：只保留读数为 0 以外、且标签不像 AUXTIN 空脚的
fan_temp_sources() {
  local d; d=$(nct_dir) || return 0
  local t n lbl v out=""
  for t in "$d"/temp[0-9]*_input; do
    [ -e "$t" ] || continue
    n=$(basename "$t"); n=${n#temp}; n=${n%_input}
    v=$(cat "$t" 2>/dev/null || echo 0)
    # 跳过明显无效的空脚（读数为 0）
    [ "$v" -gt 0 ] 2>/dev/null || continue
    lbl=$(cat "$d/temp${n}_label" 2>/dev/null)
    [ -n "$lbl" ] || lbl="temp$n"
    # 每行一条「编号|标签」。**不能**用空格分隔：标签形如 "PECI Agent 0" 会被拆碎。
    printf '%s|%s\n' "$n" "$lbl"
  done
}

# 保存通道原始状态（只在首次碰它时存，绝不覆盖）
fan_save_baseline() {
  local n="$1" d; d=$(nct_dir) || return 0
  case "$n" in ''|*[!0-9]*) return 0 ;; esac   # 空/非法通道号直接不存，防生成 pwm.saved 空文件
  mkdir -p "$FANBASE"
  [ -f "$FANBASE/pwm${n}.saved" ] && return 0
  {
    for k in enable mode temp_sel floor start stop_time step_up_time step_down_time temp_tolerance; do
      [ -e "$d/pwm${n}_${k}" ] && printf '%s=%s\n' "$k" "$(cat "$d/pwm${n}_${k}" 2>/dev/null)"
    done
    [ -e "$d/pwm${n}" ] && printf 'pwm=%s\n' "$(cat "$d/pwm${n}" 2>/dev/null)"
    for p in 1 2 3 4 5; do
      [ -e "$d/pwm${n}_auto_point${p}_temp" ] && printf 'point%s_temp=%s\n' "$p" "$(cat "$d/pwm${n}_auto_point${p}_temp" 2>/dev/null)"
      [ -e "$d/pwm${n}_auto_point${p}_pwm" ]  && printf 'point%s_pwm=%s\n'  "$p" "$(cat "$d/pwm${n}_auto_point${p}_pwm" 2>/dev/null)"
    done
  } > "$FANBASE/pwm${n}.saved"
}

# 按基线还原某通道
fan_restore_baseline() {
  local n="$1" d f; d=$(nct_dir) || return 0
  [ -f "$FANBASE/pwm${n}.saved" ] || return 0
  while IFS='=' read -r k v; do
    [ -n "$k" ] || continue
    case "$k" in
      enable|mode|temp_sel|floor|start|stop_time|step_up_time|step_down_time|temp_tolerance) f="$d/pwm${n}_${k}" ;;
      pwm) f="$d/pwm${n}" ;;
      point*temp)  f="$d/pwm${n}_auto_${k%_temp}_temp" ;;
      point*pwm)   f="$d/pwm${n}_auto_${k%_pwm}_pwm" ;;
      *) continue ;;
    esac
    [ -e "$f" ] && printf '%s' "$v" > "$f" 2>/dev/null
  done < "$FANBASE/pwm${n}.saved"
  return 0
}

# 校验曲线：形如 25:30,30:60,45:120,60:200,80:255 —— 恰 5 点，温度严格升序，占空比 1~255
valid_curve() {
  local v="$1" pts t w prev=-1 n=0 out=""
  IFS=',' read -ra pts <<< "$v"
  [ "${#pts[@]}" = 5 ] || die "曲线必须是 5 个点（温度:占空比，逗号分隔），现为 ${#pts[@]} 个"
  for p in "${pts[@]}"; do
    t="${p%%:*}"; w="${p##*:}"
    case "$t" in ''|*[!0-9]*) die "曲线温度必须是整数摄氏度：$p" ;; esac
    case "$w" in ''|*[!0-9]*) die "曲线占空比必须是整数：$p" ;; esac
    [ "$t" -ge 0 ] && [ "$t" -le 120 ] || die "曲线温度应在 0~120℃：$p"
    [ "$w" -ge "$FAN_PWM_MIN" ] && [ "$w" -le 255 ] || die "曲线占空比应在 $FAN_PWM_MIN~255：$p"
    [ "$t" -gt "$prev" ] || die "曲线温度必须严格递增（前一点 $prev，当前 $t）"
    prev=$t; n=$((n+1))
    out="$out$t:$w,"
  done
  VALID="${out%,}"
}

valid_fan_mode() { case "$1" in off|auto|manual) VALID="$1" ;; *) die "风扇模式只能是 off / auto / manual：$1" ;; esac; }

# 通道必须真实存在——否则写进配置也毫无作用，只会让人误以为设好了
valid_fan_channel() {
  local v="$1" n
  case "$v" in ''|*[!0-9]*) die "风扇通道号不合法：$v" ;; esac
  for n in $(fan_channels); do [ "$n" = "$v" ] && { VALID="$v"; return 0; }; done
  die "本机没有风扇通道 $v。可用：$(fan_channels | tr ' ' ' ')"
}
valid_fan_sel() {
  local v="$1" line ok=0
  case "$v" in ''|*[!0-9]*) die "温度源编号必须是整数：$v" ;; esac
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "${line%%|*}" = "$v" ] && ok=1
  done <<EOF
$(fan_temp_sources)
EOF
  [ "$ok" = 1 ] || die "无此温度源：temp$v。可用：$(fan_temp_sources | tr '\n' ' ' | sed 's/|/=/g')"
  VALID="$v"
}
valid_pwm() {
  local v="$1"
  case "$v" in ''|*[!0-9]*) die "占空比必须是整数：$v" ;; esac
  [ "$v" -ge "$FAN_PWM_MIN" ] && [ "$v" -le 255 ] || die "占空比应在 $FAN_PWM_MIN~255（0 会停转，禁止）：$v"
  VALID="$v"
}

# 施加单个通道
fan_apply_one() {   # $1=通道号
  local n="$1" d; d=$(nct_dir) || return 0
  local var="FAN${n}"
  local mode; eval "mode=\${${var}_MODE:-off}"
  local sel;  eval "sel=\${${var}_SEL:-2}"
  local man;  eval "man=\${${var}_MANUAL:-128}"
  local curve; eval "curve=\${${var}_CURVE:-}"

  local before; before=$(fan_rpm "$n")
  fan_save_baseline "$n"

  case "$mode" in
    off)
      fan_restore_baseline "$n"
      return 0 ;;
    manual)
      [ -e "$d/pwm${n}" ] && printf '%s' "$man" > "$d/pwm${n}" 2>/dev/null
      [ -e "$d/pwm${n}_enable" ] && printf '1' > "$d/pwm${n}_enable" 2>/dev/null
      ;;
    auto)
      [ -e "$d/pwm${n}_temp_sel" ] && printf '%s' "$sel" > "$d/pwm${n}_temp_sel" 2>/dev/null
      local i=1 p t w
      IFS=',' read -ra PTS <<< "$curve"
      for p in "${PTS[@]}"; do
        t="${p%%:*}"; w="${p##*:}"
        [ -e "$d/pwm${n}_auto_point${i}_temp" ] && printf '%s' "$(( t * 1000 ))" > "$d/pwm${n}_auto_point${i}_temp" 2>/dev/null
        [ -e "$d/pwm${n}_auto_point${i}_pwm" ]  && printf '%s' "$w" > "$d/pwm${n}_auto_point${i}_pwm" 2>/dev/null
        i=$((i+1))
      done
      # enable=5 最后写：先把曲线铺好，再交给硬件，避免中途以半截曲线运行
      [ -e "$d/pwm${n}_enable" ] && printf '5' > "$d/pwm${n}_enable" 2>/dev/null
      ;;
  esac

  # 安全阀：原本在转、写完变 0 → 立即还原（可能是写错了通道或占空比过低）
  sleep 3
  local after; after=$(fan_rpm "$n")
  if [ "$before" -gt 0 ] && [ "$after" = 0 ]; then
    fan_restore_baseline "$n"
    die "风扇 $n 施加后停转（原 $before RPM → 0），已还原原状。请检查占空比/温度源。"
  fi
  return 0
}

fan_apply_all() {
  local n
  nct_dir >/dev/null 2>&1 || return 0     # 没有 nct 芯片就静静跳过
  for n in $(fan_channels); do fan_apply_one "$n"; done
  return 0
}

# 状态输出：每个通道一行 JSON 片段
fan_status_json() {
  local n d out=""
  d=$(nct_dir) 2>/dev/null || { printf '[]'; return; }
  for n in $(fan_channels); do
    local mode sel man curve en pwm rpm
    eval "mode=\${FAN${n}_MODE:-off}"
    eval "sel=\${FAN${n}_SEL:-2}"
    eval "man=\${FAN${n}_MANUAL:-128}"
    eval "curve=\${FAN${n}_CURVE:-25:30,30:60,45:120,60:200,80:255}"
    en=$(cat "$d/pwm${n}_enable" 2>/dev/null || echo -1)
    pwm=$(cat "$d/pwm${n}" 2>/dev/null || echo -1)
    rpm=$(fan_rpm "$n")
    out="$out{\"n\":$n,\"rpm\":$rpm,\"enable\":$en,\"pwm\":$pwm,\"mode\":\"$mode\",\"sel\":$sel,\"manual\":$man,\"curve\":\"$curve\"},"
  done
  printf '[%s]' "${out%,}"
}

# JSON 字符串转义（标签里可能有引号或反斜杠）
json_esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

fan_sources_json() {
  local line n lbl out=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    n="${line%%|*}"; lbl="${line#*|}"
    out="$out{\"n\":${n},\"label\":\"$(json_esc "$lbl")\"},"
  done <<EOF
$(fan_temp_sources)
EOF
  printf '[%s]' "${out%,}"
}

# ---------- 校验 ----------
# 说明：这些 valid_* 一律「把结果写进全局 VALID」而非 printf，调用方**直接调用**再读 $VALID。
# 原因：`X=$(valid_...)` 会把函数放进子 shell，里面 die → exit 1 只能杀掉子 shell，
# 父进程照旧往下走，于是非法输入会「打印了错误却仍然写配置」。这个坑必须避开。
valid_gov() {
  local v="$1" g
  for g in $(gov_list | tr ',' ' '); do
    [ "$g" = "$v" ] && { VALID="$v"; return 0; }
  done
  die "不支持的调频模式「$v」。本机可用：$(gov_list | tr ',' ' ')"
}
# 频率：**输入为 MHz**，返回 kHz（供写 sysfs）。同时接受历史 kHz 写法。
valid_freq_mhz() {
  local v="$1" hmin hmax mhz
  case "$v" in ''|*[!0-9]*) die "频率必须是纯数字（单位 MHz）：$v" ;; esac
  if [ "$v" -gt 10000 ]; then mhz=$(( v / 1000 )); else mhz=$v; fi   # 兼容历史 kHz
  hmin=$(( $(hw_min_khz) / 1000 )); hmax=$(( $(hw_max_khz) / 1000 ))
  [ "$mhz" -lt "$hmin" ] && die "频率 $mhz MHz 低于硬件下限 $hmin MHz"
  [ "$mhz" -gt "$hmax" ] && die "频率 $mhz MHz 高于硬件上限 $hmax MHz"
  VALID="$(( mhz * 1000 ))"
}
valid_01() { case "$1" in 0|1) VALID="$1" ;; *) die "开关只能是 0 或 1：$1" ;; esac; }
# 镜像代号：必须是切换脚本自报的可用项之一（既是校验，也挡住 shell 注入）
valid_mirror() {
  local v="$1" m
  [ -x "$MIRROR" ] || die "找不到镜像切换脚本 $MIRROR"
  for m in $("$MIRROR" list 2>/dev/null | awk '/^  [a-z]/ {print $1}'); do
    [ "$m" = "$v" ] && { VALID="$v"; return 0; }
  done
  die "未知镜像「$v」。可用：$("$MIRROR" list 2>/dev/null | awk '/^  [a-z]/ {print $1}' | tr '\n' ' ')"
}
valid_epp() {
  local v="$1" g
  for g in $(epp_names); do [ "$g" = "$v" ] && { VALID="$v"; return 0; }; done
  die "不支持的能效偏好「$v」。本机可用：$(epp_names | tr '\n' ' ')"
}

# ---------- 写配置（MHz） ----------
write_conf() {
  cat > "$CONF" <<EOF
# PVE 工具集配置 —— 由面板「PVE 工具集」页生成，也可手工编辑
# 改后执行： /usr/local/bin/pve-hwtools-agent apply
#
# 概要显示开关（1 开 / 0 关）
SHOW_CPU_TEMP=$SHOW_CPU_TEMP
SHOW_FAN=$SHOW_FAN
SHOW_DISK=$SHOW_DISK
SHOW_CPU_FREQ=$SHOW_CPU_FREQ
#
# 屏蔽「无有效订阅」弹窗
BLOCK_SUBSCRIPTION_PROMPT=$BLOCK_SUBSCRIPTION_PROMPT
#
# CPU 调频（频率单位 **MHz**；范围须落在硬件能力内）
CPU_GOVERNOR=$CPU_GOVERNOR
CPU_FREQ_MIN=$CPU_FREQ_MIN
CPU_FREQ_MAX=$CPU_FREQ_MAX
# Turbo（1 启用 / 0 关闭；本机不支持时该项被忽略）
CPU_TURBO=$CPU_TURBO
# 能效偏好 EPP（仅部分新平台支持：performance / balance_performance / balance_power / power）
CPU_EPP=$CPU_EPP
#
# 软件源镜像（切换脚本见 /usr/local/bin/pve-mirror-switch.sh）
#   可选：ustc 中科大 / tuna 清华 / aliyun 阿里云 / tencent 腾讯云 / huawei 华为云 / official 官方源
APT_MIRROR=$APT_MIRROR
#
# 风扇控制（默认 off = 不改动主板原有策略；auto = 硬件曲线，无需守护进程）
#   FANn_MODE   off / auto / manual
#   FANn_SEL    温度源编号（见接口返回的 fan_sources，2=CPUTIN、8=PECI）
#   FANn_MANUAL 手动占空比 1~255
#   FANn_CURVE  五个点，温度:占空比，温度须严格递增
FAN1_MODE=$FAN1_MODE
FAN1_SEL=$FAN1_SEL
FAN1_MANUAL=$FAN1_MANUAL
FAN1_CURVE=$FAN1_CURVE
FAN2_MODE=$FAN2_MODE
FAN2_SEL=$FAN2_SEL
FAN2_MANUAL=$FAN2_MANUAL
FAN2_CURVE=$FAN2_CURVE
FAN3_MODE=$FAN3_MODE
FAN3_SEL=$FAN3_SEL
FAN3_MANUAL=$FAN3_MANUAL
FAN3_CURVE=$FAN3_CURVE
FAN4_MODE=$FAN4_MODE
FAN4_SEL=$FAN4_SEL
FAN4_MANUAL=$FAN4_MANUAL
FAN4_CURVE=$FAN4_CURVE
FAN5_MODE=$FAN5_MODE
FAN5_SEL=$FAN5_SEL
FAN5_MANUAL=$FAN5_MANUAL
FAN5_CURVE=$FAN5_CURVE
FAN6_MODE=$FAN6_MODE
FAN6_SEL=$FAN6_SEL
FAN6_MANUAL=$FAN6_MANUAL
FAN6_CURVE=$FAN6_CURVE
FAN7_MODE=$FAN7_MODE
FAN7_SEL=$FAN7_SEL
FAN7_MANUAL=$FAN7_MANUAL
FAN7_CURVE=$FAN7_CURVE
EOF
  chmod 644 "$CONF"
}

# ---------- 施加 CPU 调频 ----------
# 逐策略写 sysfs（内核自身接口，最通用）；写完回读校验，不符则用 cpupower 兜底一次。
apply_one() {   # $1=policy 目录  $2=governor（空则不动）  $3=min kHz  $4=max kHz
  local p=$1 g=$2 lo=$3 hi=$4
  [ -e "$p/scaling_min_freq" ] && printf '%s' "$lo" > "$p/scaling_min_freq" 2>/dev/null
  [ -e "$p/scaling_max_freq" ] && printf '%s' "$hi" > "$p/scaling_max_freq" 2>/dev/null
  [ -n "$g" ] && [ -e "$p/scaling_governor" ] && printf '%s' "$g" > "$p/scaling_governor" 2>/dev/null
  return 0
}
apply_freq() {
  local g="$CPU_GOVERNOR" lo=$(( CPU_FREQ_MIN * 1000 )) hi=$(( CPU_FREQ_MAX * 1000 ))
  local p bad=0
  cpufreq_ok || die "本机无 cpufreq 接口，无法设置调频（旧内核或禁用了调频驱动）"
  for p in $(policies); do apply_one "$p" "$g" "$lo" "$hi" || bad=1; done

  local lg lm lx
  lg=$(live_gov); lm=$(live_min); lx=$(live_max)
  if [ "$lg" != "$g" ] || [ "$lm" != "$lo" ] || [ "$lx" != "$hi" ]; then
    # 兜底：部分驱动只认 cpupower 的组合设置
    if command -v cpupower >/dev/null 2>&1; then
      cpupower frequency-set -g "$g" -d "${CPU_FREQ_MIN}MHz" -u "${CPU_FREQ_MAX}MHz" >/dev/null 2>&1 || true
      lg=$(live_gov); lm=$(live_min); lx=$(live_max)
    fi
    bad=0
    [ "$lg" != "$g" ] && bad=1
    [ "$lm" != "$lo" ] && bad=1
    [ "$lx" != "$hi" ] && bad=1
  fi
  [ "$bad" = 0 ] || die "调频未按预期生效：期望 $g ${CPU_FREQ_MIN}MHz~${CPU_FREQ_MAX}MHz，实际 $lg $((lm/1000))MHz~$((lx/1000))MHz"
  return 0
}
apply_turbo() {
  local f; f=$(turbo_file) || return 0
  local want="$CPU_TURBO" v
  if turbo_invert "$f"; then [ "$want" = "1" ] && v=0 || v=1; else v="$want"; fi
  printf '%s' "$v" > "$f" 2>/dev/null || return 0
  return 0
}
apply_epp() {
  local p base="$CPU_EPP"
  epp_avail >/dev/null || return 0
  [ -n "$base" ] || return 0
  for p in $(policies); do
    [ -e "$p/energy_performance_preference" ] || continue
    case " $(epp_names) " in *" $base "*) printf '%s' "$base" > "$p/energy_performance_preference" 2>/dev/null ;; esac
  done
  return 0
}

# ---------- 状态（JSON，频率一律 MHz） ----------
emit_status() {
  load_conf
  local jg="" g
  for g in $(gov_list | tr ',' ' '); do jg="$jg\"$g\","; done
  jg="${jg%,}"
  local je="" e
  for e in $(epp_names); do case "$e" in default) ;; *) je="$je\"$e\"," ;; esac; done
  je="${je%,}"
  local base; base=$(base_khz)
  cat <<EOF
{"show_cpu_temp":$SHOW_CPU_TEMP,"show_fan":$SHOW_FAN,"show_disk":$SHOW_DISK,"show_cpu_freq":$SHOW_CPU_FREQ,"block_subscription":$BLOCK_SUBSCRIPTION_PROMPT,"governor":"$CPU_GOVERNOR","governors":[$jg],"freq_min":$CPU_FREQ_MIN,"freq_max":$CPU_FREQ_MAX,"governor_live":"$(live_gov)","freq_min_live":$(( $(live_min) / 1000 )),"freq_max_live":$(( $(live_max) / 1000 )),"freq_cur":$(( $(live_cur) / 1000 )),"freq_hw_min":$(( $(hw_min_khz) / 1000 )),"freq_hw_max":$(( $(hw_max_khz) / 1000 )),"base_freq":$(( base / 1000 )),"turbo":$(turbo_get),"turbo_avail":$(turbo_avail),"epp":"$(epp_cur)","epp_avail":$(epp_avail),"epp_list":[$je],"driver":"$(cpudriver)","amd_pstate":"$(apstate_status)","policies":$(policies | wc -l),"cpufreq_ok":$(cpufreq_ok && echo 1 || echo 0),"cpu_brand":"$(cpu_brand)","cpu_gen":"$(cpu_gen)","cpu_vendor":"$(cpu_vendor)","apt_mirror":"$APT_MIRROR","apt_mirror_live":"$(if [ -x "$MIRROR" ]; then "$MIRROR" status 2>/dev/null | sed -n 's/.*"apt_mirror_detected":"\([^"]*\)".*/\1/p'; fi)","mirror_list":"$(if [ -x "$MIRROR" ]; then "$MIRROR" list 2>/dev/null | awk '/^  [a-z]/ {print $1}' | tr '\n' ','; fi)","apt_mirror_avail":$([ -x "$MIRROR" ] && echo true || echo false),"fan_avail":$([ -n "$(nct_dir)" ] && echo true || echo false),"fan_channels":"$(fan_channels | tr ' ' ',')","fans":$(fan_status_json),"fan_sources":$(fan_sources_json),"fan_pwm_min":$FAN_PWM_MIN,"config_file":"$CONF"}
EOF
}

# ---------- 命令 ----------
cmd_status() { emit_status; }

cmd_set() {
  need_root
  load_conf
  [ $# -gt 0 ] || die "set 需要至少一个 k=v 参数"

  local gov="$CPU_GOVERNOR" fmin="$CPU_FREQ_MIN" fmax="$CPU_FREQ_MAX"
  local turbo="$CPU_TURBO" epp="$CPU_EPP"
  local freq_changed=0 other_changed=0 mirror_changed=0 fan_changed=0 kv k v

  for kv in "$@"; do
    k="${kv%%=*}"; v="${kv#*=}"
    case "$k" in
      show_cpu_temp) valid_01 "$v"; SHOW_CPU_TEMP=$VALID ;;
      show_fan) valid_01 "$v"; SHOW_FAN=$VALID ;;
      show_disk) valid_01 "$v"; SHOW_DISK=$VALID ;;
      show_cpu_freq) valid_01 "$v"; SHOW_CPU_FREQ=$VALID ;;
      block_subscription) valid_01 "$v"; BLOCK_SUBSCRIPTION_PROMPT=$VALID ;;
      governor) valid_gov "$v"; gov=$VALID; freq_changed=1 ;;
      freq_min) valid_freq_mhz "$v"; fmin=$(( VALID / 1000 )); freq_changed=1 ;;
      freq_max) valid_freq_mhz "$v"; fmax=$(( VALID / 1000 )); freq_changed=1 ;;
      turbo) valid_01 "$v"; turbo=$VALID; other_changed=1 ;;
      epp) valid_epp "$v"; epp=$VALID; other_changed=1 ;;
      apt_mirror) valid_mirror "$v"; APT_MIRROR=$VALID; mirror_changed=1 ;;
      fan*_mode)
        local fn="${k#fan}"; fn="${fn%_mode}"
        valid_fan_channel "$fn"; fn=$VALID
        fan_save_baseline "$fn"
        valid_fan_mode "$v"; eval "FAN${fn}_MODE=\$VALID"; fan_changed=1 ;;
      fan*_sel)
        local fn="${k#fan}"; fn="${fn%_sel}"
        valid_fan_channel "$fn"; fn=$VALID
        valid_fan_sel "$v"; eval "FAN${fn}_SEL=\$VALID"; fan_changed=1 ;;
      fan*_manual)
        local fn="${k#fan}"; fn="${fn%_manual}"
        valid_fan_channel "$fn"; fn=$VALID
        valid_pwm "$v"; eval "FAN${fn}_MANUAL=\$VALID"; fan_changed=1 ;;
      fan*_curve)
        local fn="${k#fan}"; fn="${fn%_curve}"
        valid_fan_channel "$fn"; fn=$VALID
        valid_curve "$v"; eval "FAN${fn}_CURVE=\$VALID"; fan_changed=1 ;;
      *) die "未知配置项：$k" ;;
    esac
  done
  [ "$fmin" -le "$fmax" ] || die "频率下限（$fmin MHz）不能高于上限（$fmax MHz）"
  if [ "$freq_changed" = 1 ]; then
    local flim=$(( $(hw_min_khz) / 1000 )) hlim=$(( $(hw_max_khz) / 1000 ))
    [ "$fmin" -ge "$flim" ] || die "频率下限 $fmin MHz 低于硬件下限 $flim MHz"
    [ "$fmax" -le "$hlim" ] || die "频率上限 $fmax MHz 高于硬件上限 $hlim MHz"
  fi

  CPU_GOVERNOR="$gov"; CPU_FREQ_MIN="$fmin"; CPU_FREQ_MAX="$fmax"
  CPU_TURBO="$turbo"; CPU_EPP="$epp"

  # 先生效；失败则不落盘（保证配置与系统状态一致）
  if [ "$freq_changed" = 1 ]; then apply_freq; fi
  if [ "$other_changed" = 1 ]; then apply_turbo; apply_epp; fi

  # 风扇先施加：它有「停转即还原并报错」的安全阀，失败就该中止、配置不落盘
  if [ "$fan_changed" = 1 ]; then fan_apply_all; fi

  write_conf
  if [ "$mirror_changed" = 1 ] && [ -x "$MIRROR" ]; then
    # 切换只改写源文件，不做连通性验证；输出透出去，便于界面/终端看到改了什么
    "$MIRROR" set "$APT_MIRROR" 2>&1 | sed 's/^/      /' >&2 || true
  fi
  if [ -x "$RENDER" ]; then "$RENDER" >/dev/null 2>&1; fi
  emit_status
}

cmd_mirrors() {
  if [ -x "$MIRROR" ]; then "$MIRROR" list; else die "找不到 $MIRROR"; fi
}

cmd_apply() {
  need_root
  load_conf
  if cpufreq_ok; then apply_freq 2>/dev/null || true; fi
  apply_turbo
  apply_epp
  # 开机把风扇曲线也铺回去；出错只记日志，不让整个自启单元失败
  fan_apply_all 2>/dev/null || true
  if [ -x "$RENDER" ]; then "$RENDER" >/dev/null 2>&1; fi
  emit_status
}

case "${1:-status}" in
  status) cmd_status ;;
  set) shift; cmd_set "$@" ;;
  apply) cmd_apply ;;
  mirrors) cmd_mirrors ;;
  *) die "用法：pve-hwtools-agent {status|set k=v...|apply|mirrors}" ;;
esac
