FAN3_CURVE=$FAN3_CURVE
FAN4_MODE=$FAN4_MODE
FAN4_SEL=$FAN4_SEL
FAN4_MANUAL=$FAN4_MANUAL
FAN4_CURVE=$FAN4_CURVE
FAN5_MODE=$FAN5_MODE
FAN5_SEL=$FAN5_SEL
FAN5_MANUAL=$FAN5_MANUAL
FAN5_CURVE=$FAN5_CURVE
FAN6_MODE=$FAN6_MODE
FAN6_SEL=$FAN6_SEL
FAN6_MANUAL=$FAN6_MANUAL
FAN6_CURVE=$FAN6_CURVE
FAN7_MODE=$FAN7_MODE
FAN7_SEL=$FAN7_SEL
FAN7_MANUAL=$FAN7_MANUAL
FAN7_CURVE=$FAN7_CURVE
#
# 概要页显示（每通道）：auto = 有转速才显示 / on = 始终显示 / off = 不显示
#   没接风扇的插针默认 auto 即自动隐藏，无需逐个关闭
FANCH_SHOW_DEFAULT=${FANCH_SHOW_DEFAULT:-auto}
